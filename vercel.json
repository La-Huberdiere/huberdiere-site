{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/cron/rapport", "schedule": "0 6 28-31 * *" }],
  "redirects": [
    { "source": "/contact-9", "destination": "/contact", "permanent": true },
    { "source": "/mariage-chateau-touraine", "destination": "/mariage", "permanent": true },
    { "source": "/location-chateau-mariage-touraine", "destination": "/mariage", "permanent": true },
    { "source": "/location-chateau-seminaire-touraine", "destination": "/seminaire", "permanent": true },
    { "source": "/seminaire-entreprise-touraine-chateau-huberdiere", "destination": "/seminaire", "permanent": true },
    { "source": "/location-chateau-reunion-famille-touraine", "destination": "/famille", "permanent": true },
    { "source": "/lieu-retraite-stage-chateau-touraine", "destination": "/retraite", "permanent": true },
    { "source": "/chateau-location-touraine", "destination": "/sejour", "permanent": true },
    { "source": "/hebergement-chateau-touraine", "destination": "/sejour", "permanent": true },
    { "source": "/restauration-chateau-huberdiere-touraine", "destination": "/restauration", "permanent": true },
    { "source": "/activites-chateau-huberdiere-touraine", "destination": "/activites", "permanent": true },
    { "source": "/members", "destination": "/", "permanent": true },
    { "source": "/blog/bienvenue-au-chateau", "destination": "/blog/organiser-mariage-au-chateau", "permanent": true },
    { "source": "/en/blog/bienvenue-au-chateau", "destination": "/en/blog/organiser-mariage-au-chateau", "permanent": true },
    { "source": "/it/blog/bienvenue-au-chateau", "destination": "/it/blog/organiser-mariage-au-chateau", "permanent": true },
    { "source": "/article/:slug*", "destination": "/blog", "permanent": true },
    { "source": "/event-details/:slug*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
