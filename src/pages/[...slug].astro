---
import Base from "../layouts/Base.astro";
import { reader, renderMarkdocNode } from "../lib/content";

// Rend toute "page libre" créée dans Keystatic (collection Pages libres).
// Une page « tarifs » dans Keystatic apparaît automatiquement sur /tarifs.
export async function getStaticPaths() {
  const slugs = await reader.collections.pages.list();
  return Promise.all(
    slugs.map(async (slug) => {
      const entry = await reader.collections.pages.read(slug);
      const body = await entry!.body();
      const node = (body as any)?.node ?? body;
      return { params: { slug }, props: { entry, html: renderMarkdocNode(node) } };
    })
  );
}

const { entry, html } = Astro.props;
---
<Base title={`${entry.title} · Château de la Huberdière`} description={entry.description}>
  {entry.heroImage && (
    <section class="page-hero">
      <img src={entry.heroImage} alt={entry.title} style="width:100%;height:100%;object-fit:cover" />
      <div class="inner">
        <h1>{entry.title}</h1>
      </div>
    </section>
  )}
  <section style={entry.heroImage ? "" : "padding-top:140px"}>
    <div class="prose reveal">
      {!entry.heroImage && <h1>{entry.title}</h1>}
      <Fragment set:html={html} />
    </div>
  </section>
</Base>
