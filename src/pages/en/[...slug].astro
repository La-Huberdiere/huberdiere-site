---
import Base from "../../layouts/Base.astro";
import FreePage from "../../components/FreePage.astro";
import { pageStaticPaths } from "../../lib/content";

// Pages libres traduites (collection pages-en). Slugs identiques au FR.
export async function getStaticPaths() {
  return pageStaticPaths("pagesEn");
}

const { entry, html } = Astro.props;
const { slug } = Astro.params;
---
<Base
  title={`${entry.title} · Château de la Huberdière`}
  description={entry.description}
  lang="en"
  path={`/${slug}`}
>
  <FreePage entry={entry} html={html} lang="en" path={`/${slug}`} slug={slug} />
</Base>
