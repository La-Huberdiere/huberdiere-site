---
import Base from "../../layouts/Base.astro";
import { pageStaticPaths } from "../../lib/content";

// Pages libres traduites (collection pages-en). Slugs identiques au FR.
export async function getStaticPaths() {
  return pageStaticPaths("pagesEn");
}

const { entry, html } = Astro.props;
const { slug } = Astro.params;
---
<Base
  title={`${entry.title} · Château de la Huberdière`}
  description={entry.description}
  lang="en"
  path={`/${slug}`}
>
  {entry.heroImage && (
    <section class="page-hero">
      <img src={entry.heroImage} alt={entry.title} style="width:100%;height:100%;object-fit:cover" />
      <div class="inner">
        <h1>{entry.title}</h1>
      </div>
    </section>
  )}
  <section style={entry.heroImage ? "" : "padding-top:140px"}>
    <div class="prose reveal">
      {!entry.heroImage && <h1>{entry.title}</h1>}
      <Fragment set:html={html} />
    </div>
  </section>
</Base>
