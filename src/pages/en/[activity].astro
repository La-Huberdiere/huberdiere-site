---
import Base from "../../layouts/Base.astro";
import MariagePage from "../../components/MariagePage.astro";
import { activities } from "../../lib/activities";
import { activitySchemas } from "../../lib/seo";
import { pageSlug } from "../../lib/routes";

// Le paramètre de route est le slug EN localisé ; l'id d'activité canonique voyage en prop.
export function getStaticPaths() {
  return Object.keys(activities).map((id) => ({ params: { activity: pageSlug(id, "en") }, props: { id } }));
}

const { id } = Astro.props;
const a = activities[id as string];
const m = a.data.en;
const schemas = activitySchemas({ m, slug: id as string, lang: "en" });
---
<Base title={m.title} description={m.description} lang="en" path={`/${id}`} image={`/og/${id}.jpg`} schemas={schemas}>
  <MariagePage m={m} cible={id} heroImg={a.hero} />
</Base>
