---
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import data from "../../data/homepage.json";
import reviews from "../../data/reviews.json";
import { lodgingBusinessSchema, LODGING_IMAGES, videoSchema } from "../../lib/seo";

// Même établissement (@id #lodging partagé), décrit dans la langue de la page.
const lodging = lodgingBusinessSchema({
  lang: "en",
  description:
    "16th-century 3-star boutique hotel in the heart of the Loire Valley, near Amboise (Touraine). Weddings, stays, corporate seminars, retreats and private events, 2 hours 20 from Paris.",
  images: LODGING_IMAGES,
  amenities: ["Private walled grounds", "Heated pool", "Reception hall", "Free Wi-Fi", "Parking", "Breakfast"],
  reviews: reviews.items,
  rating: { value: reviews.ratingValue, best: reviews.bestRating, count: reviews.reviewCount },
});

const film = videoSchema({
  name: data.en.film.videoTitle,
  description: data.en.film.videoDescription,
  lang: "en",
});
---
<Base lang="en" path="/" schemas={[lodging, film]}>
  <Home c={data.en} lang="en" />
</Base>
