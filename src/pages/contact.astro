---
import Base from "../layouts/Base.astro";
import ContactPage from "../components/ContactPage.astro";
import contact from "../data/contact.json";
import settings from "../data/settings.json";
const c = contact.fr;
const s = settings.fr;
---
<Base title={c.title} description={c.description} lang="fr" path="/contact">
  <ContactPage c={c} settings={s} cible="contact" thanksPath="/merci-mariage" />
</Base>
