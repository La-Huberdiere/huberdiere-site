---
import Base from "../../layouts/Base.astro";
import MariagePage from "../../components/MariagePage.astro";
import { activities } from "../../lib/activities";
import { activitySchemas } from "../../lib/seo";

export function getStaticPaths() {
  return Object.keys(activities).map((activity) => ({ params: { activity } }));
}

const { activity } = Astro.params;
const a = activities[activity as string];
const m = a.data.it;
const schemas = activitySchemas({ m, slug: activity as string, lang: "it" });
---
<Base title={m.title} description={m.description} lang="it" path={`/${activity}`} image={`/og/${activity}.jpg`} schemas={schemas}>
  <MariagePage m={m} cible={activity} heroImg={a.hero} />
</Base>
