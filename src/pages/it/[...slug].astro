---
import Base from "../../layouts/Base.astro";
import FreePage from "../../components/FreePage.astro";
import LegalPage from "../../components/LegalPage.astro";
import { pageStaticPaths } from "../../lib/content";

// Pages libres traduites (collection pages-it). Slugs identiques au FR.
export async function getStaticPaths() {
  return pageStaticPaths("pagesIt");
}

const { entry, html } = Astro.props;
const { slug } = Astro.params;
const isSimple = entry.layout === "simple";
---
<Base
  title={`${entry.title} · Château de la Huberdière`}
  description={entry.description}
  lang="it"
  path={`/${slug}`}
>
  {isSimple
    ? <LegalPage entry={entry} html={html} />
    : <FreePage entry={entry} html={html} lang="it" path={`/${slug}`} slug={slug} />}
</Base>
