---
import Base from "../../layouts/Base.astro";
import { reader } from "../../lib/content";

const slugs = await reader.collections.articles.list();
const articles = (
  await Promise.all(
    slugs.map(async (slug) => {
      const a = await reader.collections.articles.read(slug);
      return { slug, ...a };
    })
  )
).sort((x, y) => String(y.publishedAt || "").localeCompare(String(x.publishedAt || "")));
---
<Base title="Journal — Château de la Huberdière" description="Articles, conseils et actualités du Château de la Huberdière, en Touraine.">
  <section style="padding-top:140px">
    <div class="prose reveal">
      <span class="section-eyebrow">Le journal</span>
      <h1>Actualités du château</h1>
    </div>
    <div class="blog-list">
      {articles.map((a) => (
        <a class="blog-card reveal" href={`/blog/${a.slug}`}>
          {a.cover && <img src={a.cover} alt={a.title} />}
          <div class="blog-card-body">
            <h3>{a.title}</h3>
            <p>{a.description}</p>
          </div>
        </a>
      ))}
    </div>
    {articles.length === 0 && (
      <p class="prose" style="color:#646464">Aucun article pour le moment.</p>
    )}
  </section>

  <style>
    .blog-list {
      max-width: 1100px;
      margin: 48px auto 0;
      padding: 0 24px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 32px;
    }
    .blog-card {
      display: block;
      text-decoration: none;
      color: inherit;
      border: 1px solid #e2dccc;
      border-radius: 6px;
      overflow: hidden;
      background: #fbfaf6;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .blog-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
    .blog-card img { width: 100%; height: 200px; object-fit: cover; display: block; }
    .blog-card-body { padding: 20px 22px 26px; }
    .blog-card h3 { font-family: "Playfair Display", Georgia, serif; color: #2e3a48; margin: 0 0 8px; }
    .blog-card p { color: #646464; font-size: 0.95rem; margin: 0; }
  </style>
</Base>
