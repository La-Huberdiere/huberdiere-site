---
import BlogArticle from "../../components/BlogArticle.astro";
import { articleStaticPaths } from "../../lib/content";
export async function getStaticPaths() {
  return articleStaticPaths("articles");
}
const { slug, entry, html, toc, related } = Astro.props;
---
<BlogArticle lang="fr" slug={slug} entry={entry} html={html} toc={toc} related={related} />
