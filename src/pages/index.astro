---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import data from "../data/homepage.json";
import reviews from "../data/reviews.json";
import { lodgingBusinessSchema, LODGING_IMAGES, videoSchema } from "../lib/seo";

// L'aggregateRating + les Review ne sont émis que si reviews.items est non vide
// (de vrais avis affichés sur la page), pour rester conforme aux rich results Google.
const lodging = lodgingBusinessSchema({
  images: LODGING_IMAGES,
  amenities: [
    "Parc privé clos",
    "Piscine chauffée",
    "Salle de réception",
    "Wifi gratuit",
    "Parking",
    "Petit-déjeuner",
  ],
  reviews: reviews.items,
  rating: { value: reviews.ratingValue, best: reviews.bestRating, count: reviews.reviewCount },
});

// Film de présentation (façade YouTube dans Home) : rend la home éligible au
// résultat enrichi vidéo, attribué au domaine du château.
const film = videoSchema({
  name: data.fr.film.videoTitle,
  description: data.fr.film.videoDescription,
  lang: "fr",
});
---
<Base lang="fr" path="/" schemas={[lodging, film]}>
  <Home c={data.fr} lang="fr" />
</Base>
