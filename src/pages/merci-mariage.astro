---
import Base from "../layouts/Base.astro";
const title = "Merci — Château de la Huberdière";
---

<Base title={title} description="Votre demande a bien été envoyée.">
  <section class="final" style="padding-top:200px;min-height:70vh">
    <span class="section-eyebrow">Demande envoyée</span>
    <h2 class="reveal in">Merci, votre message<br /><span class="italic">est bien arrivé.</span></h2>
    <p class="reveal in">Nous revenons vers vous sous 24 heures avec une première proposition. À très vite à la Huberdière.</p>
    <div class="final-cta reveal in">
      <a class="btn-burgundy" href="/">Retour à l'accueil</a>
      <a class="btn-ghost" style="color:var(--ink);border-color:var(--ink)" href="/mariage">Revoir l'offre mariage</a>
    </div>
    <div class="response-line reveal in">Réponse sous 24 heures</div>
  </section>

  <!--
    Tracking de conversion : ici partent les balises GTM / GA4 / Google Ads.
    On lit l'email + téléphone hashés (SHA-256) passés en paramètres d'URL et on
    les pousse dans le dataLayer pour les conversions avancées. Sur un site normal
    (contrairement à Velo/Wix), dataLayer et crypto sont accessibles : c'est propre.
  -->
  <script is:inline>
    (function () {
      window.dataLayer = window.dataLayer || [];
      const p = new URLSearchParams(location.search);
      dataLayer.push({
        event: "lead_mariage",
        enhanced_conversion_data: { sha256_email: p.get("em") || "", sha256_phone: p.get("ph") || "" },
      });
      // GTM se déclenche sur l'événement "lead_mariage" → conversion Google Ads.
    })();
  </script>
</Base>
