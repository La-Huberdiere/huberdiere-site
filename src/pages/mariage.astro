---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import pHero from "../assets/SD_5.jpg";
import v1 from "../assets/SD_6.jpg";
import v2 from "../assets/SD_9.jpg";

const title = "Mariage au château en Touraine — Château de la Huberdière";
const description = "Célébrez votre mariage dans un château du XVIᵉ siècle au cœur des Châteaux de la Loire. Privatisation exclusive, parc de 12 hectares, de 30 à 150 convives, à 2 h de Paris.";
---

<Base title={title} description={description}>
  <section class="page-hero">
    <Image src={pHero} alt="Le parc du château pour une cérémonie de mariage" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="inner">
      <div class="eyebrow">Mariage · Val de Loire</div>
      <h1>Se marier au château<br /><span class="italic">de la Huberdière.</span></h1>
      <p>Une privatisation exclusive, un parc de douze hectares, et l'art de recevoir d'une maison de famille. À deux heures de Paris.</p>
    </div>
  </section>

  <section>
    <div class="prose reveal">
      <p>Imaginez une cérémonie laïque sous les arbres centenaires, un vin d'honneur sur la terrasse au soleil couchant, un dîner dans la grande salle voûtée, puis la fête qui se prolonge sous les étoiles. Au matin, vos proches se réveillent sur place, dans les chambres du château.</p>
      <p>La Huberdière se privatise entièrement, pour vous et vos invités seuls. De 30 à 150 convives, vous disposez du château, du parc et de la piscine, avec un interlocuteur dédié du premier rendez-vous au lendemain de la fête.</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="offer-grid">
      <div class="offer-card reveal">
        <div class="num">I</div>
        <h3>Le lieu</h3>
        <p>Château du XVIᵉ siècle, parc clos de 12 hectares, terrasse, grande salle voûtée et orangerie. Décor naturel, sans superflu.</p>
      </div>
      <div class="offer-card reveal">
        <div class="num">II</div>
        <h3>L'hébergement</h3>
        <p>Les chambres du château pour la famille proche, et des solutions à proximité pour l'ensemble des invités. Tout le monde dort sur place ou tout près.</p>
      </div>
      <div class="offer-card reveal">
        <div class="num">III</div>
        <h3>L'accompagnement</h3>
        <p>Un interlocuteur unique, des prestataires de confiance, une organisation sur mesure. Vous profitez, nous orchestrons.</p>
      </div>
    </div>
  </section>

  <section class="gallery">
    <div class="gallery-grid" style="grid-template-columns:repeat(2,1fr);grid-auto-rows:300px">
      <figure class="reveal" style="grid-column:1/2;grid-row:1/2"><Image src={v1} alt="Entrée fleurie du château" widths={[600, 1000, 1400]} sizes="50vw" /></figure>
      <figure class="reveal" style="grid-column:2/3;grid-row:1/2"><Image src={v2} alt="Grande salle dressée pour un dîner" widths={[600, 1000, 1400]} sizes="50vw" /></figure>
    </div>
  </section>

  <section class="final" id="final" style="padding-top:120px">
    <span class="section-eyebrow">Votre mariage</span>
    <h2 class="reveal">Parlons de votre<br /><span class="italic">plus beau jour.</span></h2>
    <p class="reveal">Dites-nous votre date, le nombre d'invités, l'esprit que vous imaginez. Nous vous adressons une proposition sur mesure.</p>

    <form class="lead-form reveal" id="leadForm" novalidate>
      <input type="hidden" name="cible" value="mariage" />
      <input type="hidden" name="utm_source" id="utmSource" />
      <input type="hidden" name="utm_campaign" id="utmCampaign" />
      <!-- honeypot anti-bot : caché, ne pas remplir -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

      <div class="row">
        <input type="text" name="prenom" placeholder="Prénom" required />
        <input type="text" name="nom" placeholder="Nom" required />
      </div>
      <div class="row">
        <input type="email" name="email" placeholder="Email" required />
        <input type="tel" name="telephone" placeholder="Téléphone" />
      </div>
      <textarea name="message" rows="4" placeholder="Votre projet : date envisagée, nombre d'invités, vos envies…"></textarea>

      <button type="submit" class="btn-burgundy" id="submitBtn">Recevoir une proposition</button>
      <p class="form-status" id="formStatus" role="status"></p>
    </form>
    <div class="response-line reveal">Réponse sous 24 heures</div>
  </section>

  <script is:inline>
    (function () {
      const form = document.getElementById("leadForm");
      const status = document.getElementById("formStatus");
      const btn = document.getElementById("submitBtn");
      const q = new URLSearchParams(location.search);
      document.getElementById("utmSource").value = q.get("utm_source") || "";
      document.getElementById("utmCampaign").value = q.get("utm_campaign") || "";

      async function sha256(str) {
        if (!str || !crypto?.subtle) return "";
        const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str.trim().toLowerCase()));
        return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, "0")).join("");
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        btn.disabled = true;
        status.textContent = "Envoi en cours…";
        const data = Object.fromEntries(new FormData(form).entries());
        try {
          const res = await fetch("/api/lead", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(data),
          });
          if (!res.ok) throw new Error("http " + res.status);
          // conversions avancées : on hashe email + téléphone côté client
          const em = await sha256(data.email);
          const ph = await sha256((data.telephone || "").replace(/[^0-9+]/g, ""));
          location.href = `/merci-mariage?em=${em}&ph=${ph}`;
        } catch (err) {
          btn.disabled = false;
          status.textContent = "Une erreur est survenue. Réessayez ou écrivez-nous à contact@chateaudelahuberdiere.com";
        }
      });
    })();
  </script>
</Base>
