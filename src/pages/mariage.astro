---
import Base from "../layouts/Base.astro";
import MariagePage from "../components/MariagePage.astro";
import data from "../data/mariage.json";
import { activitySchemas } from "../lib/seo";
const m = data.fr;
const schemas = activitySchemas({ m, slug: "mariage", lang: "fr" });
---
<Base title={m.title} description={m.description} lang="fr" path="/mariage" image="/og/mariage.jpg" schemas={schemas}>
  <MariagePage m={m} />
</Base>
