---
import "../styles/global.css";
// Polices auto-hébergées (supprime la requête Google Fonts bloquante + risque RGPD du CDN).
// Sous-ensemble « latin » seulement : le site est FR/EN/IT, inutile de charger les blocs
// cyrillique/vietnamien des CSS complètes (allège le CSS de polices, ~39 Ko → ~10 Ko).
import "@fontsource/playfair-display/latin-400.css";
import "@fontsource/playfair-display/latin-500.css";
import "@fontsource/playfair-display/latin-600.css";
import "@fontsource/playfair-display/latin-700.css";
import "@fontsource/playfair-display/latin-400-italic.css";
import "@fontsource/playfair-display/latin-500-italic.css";
import "@fontsource/montserrat/latin-200.css";
import "@fontsource/montserrat/latin-300.css";
import "@fontsource/montserrat/latin-400.css";
import "@fontsource/montserrat/latin-500.css";
import "@fontsource/montserrat/latin-600.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import settingsData from "../data/settings.json";
import { SITE, organizationSchema, webSiteSchema } from "../lib/seo";
import { localizePath } from "../lib/routes";

interface Props {
  title?: string;
  description?: string;
  lang?: "fr" | "en" | "it";
  path?: string; // chemin sans préfixe de langue, ex. "/" ou "/mariage"
  image?: string; // image OG (chemin public ou URL absolue)
  noindex?: boolean; // pages à exclure de l'index (merci, etc.)
  ogType?: "website" | "article";
  schemas?: object[]; // données structurées spécifiques à la page
}
const {
  title,
  description,
  lang = "fr",
  path = "/",
  image,
  noindex = false,
  ogType = "website",
  schemas = [],
} = Astro.props;

const s = settingsData[lang];

// Libellés localisés de la visionneuse photo (lightbox globale : markup + script en bas de page).
const pvL = ({
  fr: { label: "Photo agrandie", close: "Fermer", prev: "Photo précédente", next: "Photo suivante" },
  en: { label: "Enlarged photo", close: "Close", prev: "Previous photo", next: "Next photo" },
  it: { label: "Foto ingrandita", close: "Chiudi", prev: "Foto precedente", next: "Foto successiva" },
} as Record<string, { label: string; close: string; prev: string; next: string }>)[lang] ?? { label: "Photo", close: "Fermer", prev: "Précédente", next: "Suivante" };

const defaults = {
  fr: {
    title: "Château de la Huberdière · Hôtel de charme, mariage & séminaire en Val de Loire",
    description: "Hôtel de charme du XVIᵉ siècle au cœur des Châteaux de la Loire, près d'Amboise. Mariages, séjours, séminaires, retraites et réunions de famille, à 2 h 20 de Paris.",
  },
  en: {
    title: "Château de la Huberdière · Boutique hotel, weddings & seminars in the Loire Valley",
    description: "A 16th-century boutique hotel in the heart of the Loire Valley, near Amboise. Weddings, stays, seminars, retreats and family gatherings, 2 hours 20 from Paris.",
  },
  it: {
    title: "Château de la Huberdière · Hotel di charme, matrimoni e seminari nella Valle della Loira",
    description: "Hotel di charme del XVI secolo nel cuore della Valle della Loira, vicino ad Amboise. Matrimoni, soggiorni, seminari, ritiri e riunioni di famiglia, a 2 ore e 20 da Parigi.",
  },
};
const metaTitle = title ?? defaults[lang].title;
const metaDescription = description ?? defaults[lang].description;

// URLs par langue pour le même contenu. `path` est toujours le chemin « style FR »
// (id canonique) ; localizePath applique le slug traduit + le préfixe de langue.
// Ainsi hreflang, canonical et sélecteur de langue pointent le bon slug par langue.
const localePath = (l: string) => localizePath(path, l as "fr" | "en" | "it");
const langs = [
  { code: "fr", label: "FR", href: localePath("fr") },
  { code: "en", label: "EN", href: localePath("en") },
  { code: "it", label: "IT", href: localePath("it") },
];
const hreflangMap: Record<string, string> = { fr: "fr-fr", en: "en-gb", it: "it-it" };

const htmlLang = lang === "en" ? "en-GB" : lang === "it" ? "it-IT" : "fr-FR";
const ogLocale = lang === "en" ? "en_GB" : lang === "it" ? "it_IT" : "fr_FR";

// URL canonique de la page courante (auto-référente, sensible à la langue).
const canonical = new URL(localePath(lang), Astro.site).href;
// Image OG servie par le domaine canonique (le site est en prod sur Vercel).
const ogImage = new URL(image ?? SITE.ogImage, Astro.site).href;

// Données structurées : Organisation + WebSite partout, + schemas de la page.
const allSchemas = [organizationSchema(), webSiteSchema(lang), ...schemas];
const robots = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";

// Mesure d'audience (activée par variables d'env, sinon rien ne se charge).
// GTM/GA4 et Google Ads passent sous Consent Mode v2 (refusé par défaut, RGPD).
// Umami est cookieless/RGPD : il peut se charger sans consentement.
const GTM_ID = import.meta.env.PUBLIC_GTM_ID;
const UMAMI_SRC = import.meta.env.PUBLIC_UMAMI_SRC;
const UMAMI_ID = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Consent Mode v2 : tout refusé par défaut, réapplique un choix déjà donné. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        wait_for_update: 500,
      });
      try {
        if (localStorage.getItem("huber-consent") === "granted") {
          gtag("consent", "update", {
            ad_storage: "granted",
            ad_user_data: "granted",
            ad_personalization: "granted",
            analytics_storage: "granted",
          });
        }
      } catch (e) {}
    </script>

    {/* Helper de tracking unifié : envoie chaque événement à Umami ET au dataLayer (GTM/Ads).
        Défini tôt pour être dispo dans tous les scripts inline. + écouteurs délégués. */}
    <script is:inline>
      window.huberTrack = function (name, data) {
        try { (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: name }, data || {})); } catch (e) {}
        try { if (window.umami) window.umami.track(name, data || {}); } catch (e) {}
      };
      document.addEventListener(
        "click",
        function (e) {
          var a = e.target && e.target.closest ? e.target.closest("a") : null;
          if (!a) return;
          var href = a.getAttribute("href") || "";
          if (href.indexOf("tel:") === 0) window.huberTrack("contact_click", { method: "phone" });
          else if (href.indexOf("mailto:") === 0) window.huberTrack("contact_click", { method: "email" });
          else if (/octorate\.com|result\.xhtml/.test(href)) {
            // CTA « Réserver » du header : intention de réservation (comme la recherche du widget).
            window.huberTrack("reserve_click", {});
            window.huberTrack("booking_search", { source: "header" });
          }
        },
        true
      );
    </script>

    {/* Google Tag Manager (chargé seulement si PUBLIC_GTM_ID est défini) */}
    {GTM_ID && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`} />
    )}

    {/* Umami (cookieless, RGPD) : audience anonyme, sans consentement requis */}
    {UMAMI_SRC && UMAMI_ID && (
      <script is:inline async src={UMAMI_SRC} data-website-id={UMAMI_ID}></script>
    )}

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#8B0000" />
    {/* Le widget de réservation Octorate se charge depuis resx.octorate.com :
        on ouvre la connexion tôt pour accélérer l'affichage de la barre de recherche. */}
    <link rel="preconnect" href="https://resx.octorate.com" crossorigin />
    <link rel="dns-prefetch" href="https://resx.octorate.com" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/* hreflang */}
    {langs.map((l) => (
      <link rel="alternate" hreflang={hreflangMap[l.code]} href={new URL(l.href, Astro.site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath("fr"), Astro.site).href} />

    {allSchemas.map((sc) => (
      <script type="application/ld+json" set:html={JSON.stringify(sc)} />
    ))}
  </head>
  <body>
    {GTM_ID && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <Header settings={s} lang={lang} langs={langs} />
    <slot />
    <Footer settings={s} lang={lang} />
    <CookieBanner lang={lang} />

    {/* Visionneuse photo globale : rend cliquable/agrandissable toute image de contenu (hors header/footer). */}
    <div class="pv-lightbox" id="pvLightbox" role="dialog" aria-modal="true" aria-label={pvL.label} hidden>
      <button class="pv-btn pv-close" id="pvClose" type="button" aria-label={pvL.close}>&times;</button>
      <button class="pv-btn pv-nav pv-prev" id="pvPrev" type="button" aria-label={pvL.prev}>&#8249;</button>
      <img class="pv-img" id="pvImg" src="" alt="" />
      <button class="pv-btn pv-nav pv-next" id="pvNext" type="button" aria-label={pvL.next}>&#8250;</button>
      <span class="pv-count" id="pvCount" aria-hidden="true"></span>
    </div>

    <script is:inline>
      // Tracking Google Ads : capture les identifiants de clic (gclid/gbraid/wbraid)
      // à l'arrivée et les stocke 90 jours en cookie first-party, pour les rattacher
      // au lead lors de la soumission du formulaire (base de l'import de conversions).
      (function () {
        var p = new URLSearchParams(location.search);
        ["gclid", "gbraid", "wbraid"].forEach(function (k) {
          var v = p.get(k);
          if (v) document.cookie = k + "=" + encodeURIComponent(v) + ";path=/;max-age=7776000;samesite=lax";
        });

        // Attribution first-touch : on fige la vraie porte d'entrée (referrer externe +
        // UTM) au tout premier chargement et on la garde 90 jours. La navigation interne
        // n'écrase plus la source (le bug qui faisait ressortir « Lien externe » = la page
        // elle-même). Non réécrit tant qu'un cookie exploitable existe (vrai first-touch).
        function ck(n) {
          return (document.cookie.match(new RegExp("(?:^|; )" + n + "=([^;]*)")) || [])[1] || "";
        }
        if (!ck("ht_attr")) {
          var ref = document.referrer || "";
          var ext = "";
          try {
            var here = location.hostname.replace(/^www\./, "");
            if (ref && new URL(ref).hostname.replace(/^www\./, "") !== here) ext = ref;
          } catch (e) {}
          var attr = {
            ref: ext,
            us: p.get("utm_source") || "",
            um: p.get("utm_medium") || "",
            uc: p.get("utm_campaign") || "",
            ut: p.get("utm_term") || "",
            un: p.get("utm_content") || "",
            lp: location.pathname,
          };
          // On ne pose le cookie que s'il y a une source exploitable (referrer externe ou
          // UTM). Une 1re visite en accès direct reste ouverte : un futur passage taggé
          // (lien Insta/fiche Google avec UTM) pourra renseigner l'attribution.
          if (attr.ref || attr.us) {
            document.cookie =
              "ht_attr=" + encodeURIComponent(JSON.stringify(attr)) + ";path=/;max-age=7776000;samesite=lax";
          }
        }
      })();
    </script>
    <script>
      const header = document.getElementById("siteHeader");
      const hasHero = !!document.querySelector(".hero, .page-hero");
      const setSolid = () => header?.classList.toggle("solid", !hasHero || window.scrollY > 40);
      setSolid(); // état initial posé SANS transition (pas d'animation au chargement)
      // La transition ne s'active qu'au 1er scroll réel (c'est là qu'on la veut).
      window.addEventListener("scroll", () => {
        header?.classList.add("anim");
        setSolid();
      }, { passive: true });

      document.getElementById("hero")?.classList.add("loaded");

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>

    <script>
      // Visionneuse photo globale : toute image de contenu devient cliquable et
      // s'affiche en grand. Exclut header/footer/logo, images-liens et vignettes.
      // Navigation par groupe (carrousels chambres, galeries) au clavier et au swipe.
      (function () {
        const lb = document.getElementById("pvLightbox");
        // La page /galerie a déjà sa propre visionneuse (#lightbox) : on ne doublonne pas.
        if (!lb || document.getElementById("lightbox")) return;
        const img = document.getElementById("pvImg");
        const countEl = document.getElementById("pvCount");
        const prevBtn = document.getElementById("pvPrev");
        const nextBtn = document.getElementById("pvNext");
        const closeBtn = document.getElementById("pvClose");
        const GROUP_SEL = ".room-gallery, .landing-gallery, .gallery, .gallery-grid";
        let group = [], idx = 0, lastFocus = null;

        function eligible(el) {
          if (!(el instanceof HTMLImageElement)) return false;
          if (el.closest("header, .site-header, footer, a, [data-no-zoom]")) return false;
          if (el.classList.contains("brand-logo")) return false;
          const w = el.naturalWidth || 0;
          if (w && w < 200) return false; // écarte avatars / icônes une fois chargés
          return true;
        }
        function hiRes(el) {
          let best = el.currentSrc || el.src, bestW = 0;
          if (el.srcset) {
            el.srcset.split(",").forEach((part) => {
              const seg = part.trim().split(/\s+/);
              const wd = seg[1] && seg[1].endsWith("w") ? parseInt(seg[1]) : 0;
              if (seg[0] && wd >= bestW) { bestW = wd; best = seg[0]; }
            });
          }
          return best;
        }
        function groupOf(el) {
          const cont = el.closest(GROUP_SEL);
          return cont ? Array.prototype.filter.call(cont.querySelectorAll("img"), eligible) : [el];
        }
        function show(i) {
          idx = (i + group.length) % group.length;
          const el = group[idx];
          img.src = hiRes(el);
          img.alt = el.alt || "";
          const many = group.length > 1;
          prevBtn.hidden = !many; nextBtn.hidden = !many;
          countEl.textContent = many ? idx + 1 + " / " + group.length : "";
        }
        function open(el) {
          group = groupOf(el);
          idx = group.indexOf(el); if (idx < 0) idx = 0;
          lastFocus = document.activeElement;
          lb.hidden = false;
          document.body.style.overflow = "hidden";
          show(idx);
          closeBtn.focus();
        }
        function close() {
          lb.hidden = true;
          document.body.style.overflow = "";
          img.removeAttribute("src");
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }
        document.addEventListener("click", (e) => {
          const el = e.target && e.target.closest && e.target.closest("img");
          if (el && eligible(el)) { e.preventDefault(); open(el); }
        });
        const mark = () => document.querySelectorAll("img").forEach((el) => { if (eligible(el)) el.classList.add("pv-zoomable"); });
        mark();
        window.addEventListener("load", mark);
        closeBtn.addEventListener("click", close);
        prevBtn.addEventListener("click", () => show(idx - 1));
        nextBtn.addEventListener("click", () => show(idx + 1));
        lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
        document.addEventListener("keydown", (e) => {
          if (lb.hidden) return;
          if (e.key === "Escape") close();
          else if (e.key === "ArrowLeft") show(idx - 1);
          else if (e.key === "ArrowRight") show(idx + 1);
        });
        let sx = 0;
        lb.addEventListener("touchstart", (e) => { sx = e.changedTouches[0].clientX; }, { passive: true });
        lb.addEventListener("touchend", (e) => {
          const dx = e.changedTouches[0].clientX - sx;
          if (group.length > 1 && Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1));
        }, { passive: true });
      })();
    </script>
  </body>
</html>
