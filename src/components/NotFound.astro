---
// Page 404 (introuvable), une par langue. Texte éditable depuis Keystatic
// (singleton « Textes du site »). Les liens sont préfixés selon la langue.
import siteTexts from "../data/site-texts.json";
const { lang = "fr" } = Astro.props;
const prefix = lang === "fr" ? "" : `/${lang}`;
const nf = ((siteTexts as any)[lang] ?? (siteTexts as any).fr).notFound;
---
<main class="notfound">
  <p class="nf-eyebrow">{nf.eyebrow}</p>
  <h1>{nf.title}</h1>
  <p class="nf-text">{nf.text}</p>
  <a class="nf-cta" href={`${prefix}/`}>{nf.home}</a>
  <nav class="nf-links" aria-label="Pages">
    {nf.links.map((l) => <a href={`${prefix}${l.href}`}>{l.label}</a>)}
  </nav>
</main>

<style>
  .notfound {
    max-width: 680px;
    margin: 0 auto;
    padding: 160px 24px 120px;
    text-align: center;
  }
  .nf-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.78rem;
    color: var(--bordeaux, #8b0000);
    margin: 0 0 12px;
  }
  .notfound h1 {
    font-family: "Playfair Display", serif;
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    color: var(--ink, #212121);
    margin: 0 0 18px;
  }
  .nf-text {
    color: var(--gris, #646464);
    line-height: 1.7;
    margin: 0 0 32px;
  }
  .nf-cta {
    display: inline-block;
    background: var(--bordeaux, #8b0000);
    color: #fff;
    padding: 14px 30px;
    border-radius: 4px;
    text-decoration: none;
    font-family: "Montserrat", sans-serif;
    letter-spacing: 0.04em;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    margin-top: 40px;
  }
  .nf-links a {
    color: var(--slate, #2e3a48);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .nf-links a:hover {
    border-bottom-color: var(--bordeaux, #8b0000);
  }
</style>
