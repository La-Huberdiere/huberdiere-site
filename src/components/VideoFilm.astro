---
// Section « Le film » : teaser muet auto-hébergé (11 s, 3 Mo) qui tourne en boucle,
// et façade YouTube qui ne charge l'iframe qu'au clic. Avant le clic : aucune requête
// vers un domaine tiers, aucun cookie, donc rien à consentir et zéro impact sur le LCP
// (le teaser n'est chargé qu'à l'approche du viewport, via IntersectionObserver).
import { Image } from "astro:assets";
import poster from "../assets/film-poster.jpg";

const { c, videoId } = Astro.props;
const teaser = "/video/huberdiere-film-teaser.mp4";
---

<section class="film" id="film" aria-labelledby="film-title">
  <div class="container film-head">
    <div class="film-rule"></div>
    <span class="section-eyebrow">{c.eyebrow}</span>
    <h2 id="film-title">{c.titlePlain}<span class="italic">{c.titleItalic}</span></h2>
    <p>{c.text}</p>
  </div>

  <figure class="film-frame" data-film data-video={videoId} data-teaser={teaser}>
    <Image
      class="film-poster"
      src={poster}
      alt={c.posterAlt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      quality={70}
      loading="lazy"
      decoding="async"
    />
    <video class="film-loop" muted loop playsinline preload="none" tabindex="-1" aria-hidden="true"></video>
    <button class="film-play" type="button">
      <span class="film-play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path d="M7 4.5v15l13-7.5z" fill="currentColor"></path></svg>
      </span>
      <span class="film-play-label">{c.playLabel}</span>
    </button>
    <figcaption class="film-caption">{c.caption}</figcaption>
  </figure>
</section>

<script>
  const frame = document.querySelector("[data-film]");

  if (frame instanceof HTMLElement) {
    const video = frame.querySelector(".film-loop") as HTMLVideoElement | null;
    const button = frame.querySelector(".film-play") as HTMLButtonElement | null;
    const teaser = frame.dataset.teaser || "";
    const videoId = frame.dataset.video || "";

    // On ne télécharge pas les 3 Mo du teaser si l'utilisateur a demandé moins
    // d'animation, s'il est en économie de données, ou s'il est sur téléphone :
    // là, l'affiche fixe et le bouton suffisent, le film reste à une pression.
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const smallScreen = window.matchMedia("(max-width: 768px)").matches;
    const conn = (navigator as any).connection;
    const saveData = !!(conn && (conn.saveData || /2g/.test(conn.effectiveType || "")));
    const wantsLoop = !reducedMotion && !saveData && !smallScreen;

    /** Charge la source du teaser au dernier moment, puis le lance. */
    const startLoop = () => {
      if (!video || video.dataset.ready) return;
      video.dataset.ready = "1";
      video.src = teaser;
      video.addEventListener("playing", () => frame.classList.add("is-playing"), { once: true });
      video.play().catch(() => {
        // Autoplay refusé : le poster reste affiché, rien à réparer.
      });
    };

    if (wantsLoop && video) {
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              // Une fois le film YouTube lancé, la boucle ne reprend plus la main.
              if (frame.classList.contains("is-film")) continue;
              if (entry.isIntersecting) {
                if (!video.dataset.ready) startLoop();
                else if (video.paused) video.play().catch(() => {});
              } else if (video.dataset.ready) {
                // Hors écran : pause, pour ne pas décoder dans le vide (batterie).
                video.pause();
              }
            }
          },
          { rootMargin: "400px 0px" }
        );
        io.observe(frame);
      } else {
        startLoop();
      }
    }

    // Clic : le teaser muet cède la place au film complet avec le son, servi par
    // YouTube en mode nocookie (aucun cookie tant que personne n'a cliqué).
    // Écouteur posé sur toute l'image, le bouton n'étant que le repère visuel :
    // un visiteur qui clique la vidéo attend qu'elle démarre, pas qu'il vise.
    frame.addEventListener("click", () => {
      if (!videoId || frame.classList.contains("is-film")) return;
      frame.classList.add("is-film");
      video?.pause();

      const iframe = document.createElement("iframe");
      iframe.className = "film-embed";
      iframe.src =
        "https://www.youtube-nocookie.com/embed/" +
        videoId +
        "?autoplay=1&rel=0&modestbranding=1&playsinline=1&color=white";
      iframe.title = button?.querySelector(".film-play-label")?.textContent || "Film";
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen";
      iframe.setAttribute("allowfullscreen", "");
      iframe.loading = "lazy";
      frame.appendChild(iframe);

      if (typeof (window as any).huberTrack === "function") {
        (window as any).huberTrack("film_play", { video: videoId });
      }
    });
  }
</script>

<style>
  /* Bandeau pleine largeur : la seule section du site qui casse la marge de 48 px,
     pour que le film respire là où tout le reste est contenu. */
  .film {
    background: var(--bg-deep);
    padding: 130px 0 0;
    overflow: hidden;
  }
  .film-head {
    padding: 0 48px 68px;
    max-width: 1280px;
    /* Bloc de texte calé à gauche : on évite le énième en-tête centré. */
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 0 90px;
    align-items: end;
  }
  .film-rule {
    grid-column: 1 / 2;
    width: 64px;
    height: 2px;
    background: var(--burgundy);
    margin-bottom: 26px;
  }
  .film-head .section-eyebrow {
    grid-column: 1 / 2;
    grid-row: 2;
    margin-bottom: 18px;
  }
  .film-head h2 {
    grid-column: 1 / 2;
    grid-row: 3;
    font-size: clamp(36px, 4.4vw, 54px);
    line-height: 1.12;
    margin: 0;
  }
  .film-head p {
    grid-column: 2 / 3;
    grid-row: 3;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.9;
    color: var(--ink-2);
    margin: 0;
    max-width: 62ch;
  }

  .film-frame {
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 78vh;
    background: #10161d;
    overflow: hidden;
    /* Toute l'image lance le film, pas seulement le bouton. */
    cursor: pointer;
  }
  .film-frame.is-film {
    cursor: default;
  }
  /* Survol de l'image : le bouton réagit comme s'il était visé. */
  .film-frame:not(.is-film):hover .film-play {
    background: var(--burgundy);
    border-color: var(--burgundy);
  }
  .film-frame :global(.film-poster),
  .film-loop,
  .film-frame :global(.film-embed) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    display: block;
  }
  .film-loop {
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .film-frame.is-playing .film-loop {
    opacity: 1;
  }
  .film-frame :global(.film-embed) {
    z-index: 3;
    object-fit: fill;
  }
  /* Voile bas : le film traverse des plans très clairs (feuillages en contre-jour),
     le bouton et la légende doivent rester lisibles sur n'importe quelle image. */
  .film-frame::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to top, rgba(12, 17, 23, 0.62), rgba(12, 17, 23, 0.16) 46%, rgba(12, 17, 23, 0));
    transition: opacity 0.3s ease;
  }
  .film-frame.is-film::after,
  .film-frame.is-film .film-play,
  .film-frame.is-film .film-caption {
    opacity: 0;
    pointer-events: none;
  }

  /* Bouton de lecture : rectangle net, pas de pastille ronde ni de halo. */
  .film-play {
    position: absolute;
    z-index: 2;
    left: 48px;
    bottom: 48px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 15px 24px;
    background: rgba(16, 22, 29, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.7);
    color: #fff;
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.35s ease, border-color 0.35s ease, opacity 0.3s ease;
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  .film-play:hover,
  .film-play:focus-visible {
    background: var(--burgundy);
    border-color: var(--burgundy);
  }
  .film-play-icon {
    display: inline-flex;
    align-items: center;
  }
  .film-caption {
    position: absolute;
    z-index: 2;
    right: 48px;
    bottom: 52px;
    max-width: 34ch;
    text-align: right;
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.55);
    transition: opacity 0.3s ease;
  }

  @media (max-width: 960px) {
    .film {
      padding-top: 80px;
    }
    .film-head {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0 22px 40px;
    }
    .film-head .section-eyebrow,
    .film-head h2,
    .film-head p {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .film-head h2 {
      margin-bottom: 26px;
    }
    .film-frame {
      aspect-ratio: 4 / 3;
      max-height: none;
    }
    .film-play {
      left: 22px;
      bottom: 22px;
      padding: 13px 18px;
      gap: 11px;
      font-size: 10px;
      letter-spacing: 0.18em;
    }
    .film-caption {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .film-loop {
      display: none;
    }
  }
</style>
