---
import LeadForm from "./LeadForm.astro";
import HeroPicture from "./HeroPicture.astro";
import pHero from "../assets/BD_5.jpg";
import pHeroMobile from "../assets/BD_5-portrait.jpg";

// Textes (c) et coordonnées (settings.footer) en props selon la langue.
const { c, settings, cible = "contact" } = Astro.props;
const f = settings.footer;
const lang = (Astro.currentLocale as "fr" | "en" | "it") ?? "fr";
---
<section class="page-hero">
  <HeroPicture desktop={pHero} mobile={pHeroMobile} alt={c.hero.titleLine1} />
  <div class="inner">
    <span class="hero-rule" aria-hidden="true"></span>
    <h1>{c.hero.titleLine1}<br /><span class="italic">{c.hero.titleLine2Italic}</span></h1>
    <p>{c.hero.lead}</p>
  </div>
</section>

<section class="contact-section">
  <div class="contact-grid">
    <div class="contact-info reveal">
      <h2>{c.infoTitle}</h2>
      <p class="addr">{f.addressLine1}<br />{f.addressLine2}</p>
      <p><a href={`tel:${f.phoneHref}`}>{f.phone}</a></p>
      <p><a href={`mailto:${f.email}`}>{f.email}</a></p>
      <p class="note">{c.infoNote}</p>
    </div>

    <div class="contact-form-wrap reveal">
      <p class="form-intro">{c.formIntro}</p>
      <LeadForm
        lang={lang}
        cible={cible}
        submitLabel={c.submitLabel}
        responseLine={c.responseLine}
        variant="contact"
      />
    </div>
  </div>
</section>

<style>
  .contact-section { padding: 100px 24px 120px; }
  .contact-grid {
    max-width: 1040px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 64px;
    align-items: start;
  }
  .contact-info h2 {
    font-family: "Playfair Display", Georgia, serif;
    color: #2e3a48;
    font-size: 28px;
    margin: 0 0 24px;
  }
  .contact-info p { margin: 0 0 12px; color: #2e3a48; line-height: 1.7; }
  .contact-info .addr { color: #646464; }
  .contact-info a { color: #2e3a48; text-decoration: none; border-bottom: 1px solid #d8cfc0; }
  .contact-info a:hover { color: #8b0000; }
  .contact-info .note { margin-top: 24px; color: #646464; font-size: 0.92rem; font-style: italic; }
  .contact-form-wrap .form-intro { color: #646464; margin: 0 0 22px; line-height: 1.7; }
  @media (max-width: 880px) {
    .contact-grid { grid-template-columns: 1fr; gap: 36px; }
    .contact-section { padding: 64px 22px 90px; }
  }
</style>
