---
import { Image } from "astro:assets";
import pHero from "../assets/BD_5.jpg";

// Textes (c) et coordonnées (settings.footer) en props selon la langue.
const { c, settings, cible = "contact" } = Astro.props;
const f = settings.footer;
const lang = (Astro.currentLocale as "fr" | "en" | "it") ?? "fr";
const thanksPath = lang === "fr" ? "/merci" : `/${lang}/merci`;
---
<section class="page-hero">
  <Image src={pHero} alt={c.hero.titleLine1} widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="inner">
    <div class="eyebrow">{c.hero.eyebrow}</div>
    <h1>{c.hero.titleLine1}<br /><span class="italic">{c.hero.titleLine2Italic}</span></h1>
    <p>{c.hero.lead}</p>
  </div>
</section>

<section class="contact-section">
  <div class="contact-grid">
    <div class="contact-info reveal">
      <h2>{c.infoTitle}</h2>
      <p class="addr">{f.addressLine1}<br />{f.addressLine2}</p>
      <p><a href={`tel:${f.phoneHref}`}>{f.phone}</a></p>
      <p><a href={`mailto:${f.email}`}>{f.email}</a></p>
      <p class="note">{c.infoNote}</p>
    </div>

    <div class="contact-form-wrap reveal">
      <p class="form-intro">{c.formIntro}</p>
      <form class="lead-form" id="leadForm" novalidate>
        <input type="hidden" name="cible" value={cible} />
        <input type="hidden" name="utm_source" id="utmSource" />
        <input type="hidden" name="utm_campaign" id="utmCampaign" />
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

        <div class="row">
          <input type="text" name="prenom" placeholder="Prénom" required />
          <input type="text" name="nom" placeholder="Nom" required />
        </div>
        <div class="row">
          <input type="email" name="email" placeholder="Email" required />
          <input type="tel" name="telephone" placeholder="Téléphone" />
        </div>
        <textarea name="message" rows="4" placeholder="Votre projet : dates, nombre de personnes, vos envies…"></textarea>

        <button type="submit" class="btn-burgundy" id="submitBtn">{c.submitLabel}</button>
        <p class="form-status" id="formStatus" role="status"></p>
      </form>
      <div class="response-line">{c.responseLine}</div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ thanksPath }}>
  (function () {
    const form = document.getElementById("leadForm");
    const status = document.getElementById("formStatus");
    const btn = document.getElementById("submitBtn");
    const q = new URLSearchParams(location.search);
    document.getElementById("utmSource").value = q.get("utm_source") || "";
    document.getElementById("utmCampaign").value = q.get("utm_campaign") || "";

    async function sha256(str) {
      if (!str || !crypto?.subtle) return "";
      const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str.trim().toLowerCase()));
      return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, "0")).join("");
    }

    let formStarted = false;
    form.addEventListener("focusin", () => {
      if (formStarted) return;
      formStarted = true;
      const cb = (form.querySelector("[name=cible]") || {}).value || "";
      window.huberTrack && window.huberTrack("form_start", { cible: cb });
    }, { passive: true });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      btn.disabled = true;
      status.textContent = "Envoi en cours…";
      const data = Object.fromEntries(new FormData(form).entries());
      data.lang = (document.documentElement.lang || "fr").slice(0, 2);
      const qp = new URLSearchParams(location.search);
      data.utm_medium = qp.get("utm_medium") || "";
      data.utm_term = qp.get("utm_term") || "";
      data.utm_content = qp.get("utm_content") || "";
      data.page = location.pathname + location.search;
      data.referrer = document.referrer || "";
      const cookie = (n) => (document.cookie.match(new RegExp("(?:^|; )" + n + "=([^;]*)")) || [])[1] || "";
      data.gclid = decodeURIComponent(cookie("gclid"));
      data.gbraid = decodeURIComponent(cookie("gbraid"));
      data.wbraid = decodeURIComponent(cookie("wbraid"));
      data.lead_id = crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
      try {
        const res = await fetch("/api/lead", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error("http " + res.status);
        const em = await sha256(data.email);
        const ph = await sha256((data.telephone || "").replace(/[^0-9+]/g, ""));
        const params = new URLSearchParams({ cible: data.cible || "", em, ph, lead_id: data.lead_id });
        if (data.gclid) params.set("gclid", data.gclid);
        location.href = `${thanksPath}?${params.toString()}`;
      } catch (err) {
        btn.disabled = false;
        status.textContent = "Une erreur est survenue. Réessayez ou écrivez-nous à contact@chateaudelahuberdiere.com";
      }
    });
  })();
</script>

<style>
  .contact-section { padding: 100px 24px 120px; }
  .contact-grid {
    max-width: 1040px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 64px;
    align-items: start;
  }
  .contact-info h2 {
    font-family: "Playfair Display", Georgia, serif;
    color: #2e3a48;
    font-size: 28px;
    margin: 0 0 24px;
  }
  .contact-info p { margin: 0 0 12px; color: #2e3a48; line-height: 1.7; }
  .contact-info .addr { color: #646464; }
  .contact-info a { color: #2e3a48; text-decoration: none; border-bottom: 1px solid #d8cfc0; }
  .contact-info a:hover { color: #8b0000; }
  .contact-info .note { margin-top: 24px; color: #646464; font-size: 0.92rem; font-style: italic; }
  .contact-form-wrap .form-intro { color: #646464; margin: 0 0 22px; line-height: 1.7; }
  @media (max-width: 880px) {
    .contact-grid { grid-template-columns: 1fr; gap: 36px; }
    .contact-section { padding: 64px 22px 90px; }
  }
</style>
