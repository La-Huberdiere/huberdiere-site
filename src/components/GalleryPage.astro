---
import { galleryChapters, galleryUI, type Lang } from "../lib/gallery";
const { lang = "fr" } = Astro.props as { lang: Lang };
const ui = galleryUI[lang];
const chapters = galleryChapters(lang);
// Photo maîtresse du hero = l'ouverture du chapitre « château & parc » (façade large).
const parc = chapters.find((c) => c.id === "chateau-parc");
const hero = parc?.photos[0] ?? chapters[0].photos[0];
// Photo à partir de laquelle scripts/gen-hero-mobile.mjs a produit les webp. Si le
// CMS change le premier chapitre, le srcset est abandonné plutôt que de servir une
// autre photo que celle du <img>. Relancer le script et corriger cette constante.
const HERO_SOURCE = "/images/bibliotheque/chambres/chambre-01.jpg";
const heroSrcSet =
  hero.full === HERO_SOURCE
    ? [720, 1080, 1440, 1920].map((w) => `/images/hero/galerie-hero-${w}.webp ${w}w`).join(", ")
    : null;
---
<section class="page-hero gallery-hero" id="hero">
  {/* La photo d'origine était servie telle quelle, 479 Ko sans srcset : recadrée
      en 3/4 et déclinée en webp par scripts/gen-hero-mobile.mjs. */}
  <picture>
    {heroSrcSet && (
      <source
        type="image/webp"
        srcset={heroSrcSet}
        sizes="(max-width: 768px) 124vw, 100vw"
        width="1440"
        height="1920"
      />
    )}
    <img src={hero.full} alt={hero.alt} fetchpriority="high" width={hero.w} height={hero.h} />
  </picture>
  <div class="inner">
    <h1>{ui.title}</h1>
    <span class="hero-rule" aria-hidden="true"></span>
    <p>{ui.lead}</p>
  </div>
</section>

<nav class="gallery-nav" aria-label={ui.title}>
  <div class="gallery-nav__track">
    {chapters.map((c) => (
      <a href={`#${c.id}`} data-target={c.id}>
        <span class="gn-num">{c.numeral}</span>{c.title}
      </a>
    ))}
  </div>
</nav>

<div class="gallery-wrap">
  {/* Le premier chapitre se charge sans attendre l'observateur de défilement :
      113 vignettes en lazy, c'était plusieurs secondes de rectangles beiges au
      moment précis où le visiteur arrive sur une page qui ne vend que des images.
      Les dimensions sont déjà déclarées partout, il n'y a donc pas de saut de
      mise en page ; c'est bien la perception de lenteur qu'on corrige. */}
  {chapters.map((c, ci) => (
    <section class="gchapter" id={c.id}>
      <header class="gchapter__head">
        <span class="gc-num">{c.numeral}</span>
        <h2>{c.title}</h2>
        <p class="gc-intro">{c.intro}</p>
      </header>
      <button type="button" class="tile tile--lead" data-full={c.photos[0].full} data-alt={c.photos[0].alt} aria-label={c.photos[0].alt}>
        <img src={c.photos[0].thumb} alt={c.photos[0].alt} loading={ci === 0 ? "eager" : "lazy"} fetchpriority={ci === 0 ? "high" : undefined} decoding="async" width={c.photos[0].w} height={c.photos[0].h} />
        <span class="tile__cue" aria-hidden="true"><i>⤢</i></span>
      </button>
      <div class="mosaic">
        {c.photos.slice(1).map((p, pi) => (
          <button type="button" class="tile" data-full={p.full} data-alt={p.alt} aria-label={p.alt}>
            <img src={p.thumb} alt={p.alt} loading={ci === 0 && pi < 5 ? "eager" : "lazy"} decoding="async" width={p.w} height={p.h} />
            <span class="tile__cue" aria-hidden="true"><i>⤢</i></span>
          </button>
        ))}
      </div>
    </section>
  ))}
  <p class="gallery-hint">{ui.hint}</p>
</div>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label={ui.title} hidden>
  <button class="lb-btn lb-close" id="lbClose" aria-label={ui.close}>✕</button>
  <button class="lb-btn lb-prev" id="lbPrev" aria-label={ui.prev}>‹</button>
  <figure class="lb-stage">
    <img id="lbImg" src="" alt="" />
    <figcaption id="lbCap"><span id="lbAlt"></span><span id="lbCount"></span></figcaption>
  </figure>
  <button class="lb-btn lb-next" id="lbNext" aria-label={ui.next}>›</button>
</div>

<style>
  /* Hero éditorial : texte calé en bas à gauche (pas le hero centré générique). */
  .gallery-hero { height: 66vh; min-height: 560px; }
  .gallery-hero .inner {
    align-items: flex-start;
    justify-content: flex-end;
    text-align: left;
    padding: 0 clamp(22px, 6vw, 96px) clamp(44px, 7vh, 84px);
    max-width: 760px;
  }
  .gallery-hero .hero-rule { margin: 22px 0 20px; }
  .gallery-hero p { margin: 0; font-size: 15px; }

  /* Sommaire collant : chapitres, filet actif bordeaux. */
  .gallery-nav {
    position: sticky;
    top: 60px;
    z-index: 40;
    background: rgba(244, 242, 236, 0.94);
    backdrop-filter: saturate(1.1) blur(6px);
    border-bottom: 1px solid var(--line-soft);
  }
  .gallery-nav__track {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    gap: clamp(18px, 3vw, 46px);
    padding: 0 clamp(18px, 5vw, 64px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .gallery-nav__track::-webkit-scrollbar { display: none; }
  .gallery-nav a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    padding: 18px 0;
    font-family: "Montserrat", sans-serif;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.25s;
    white-space: nowrap;
  }
  .gallery-nav a .gn-num {
    font-family: "Playfair Display", serif;
    font-size: 13px;
    color: var(--burgundy);
    opacity: 0.7;
  }
  .gallery-nav a:hover { color: var(--ink); }
  .gallery-nav a.active { color: var(--ink); border-bottom-color: var(--burgundy); }
  .gallery-nav a.active .gn-num { opacity: 1; }

  .gallery-wrap { max-width: 1360px; margin: 0 auto; padding: clamp(48px, 7vw, 96px) clamp(18px, 5vw, 64px) 40px; }

  /* En-tête de chapitre : numéral maison + titre serif + compteur, intro sur une ligne. */
  /* padding:0 annule le `section{padding:140px 48px}` global qui créait de grands
     vides en haut/bas de chaque chapitre (l'espacement horizontal vient de .gallery-wrap). */
  .gchapter { padding: 0; scroll-margin-top: 128px; }
  .gchapter + .gchapter { margin-top: clamp(40px, 4vw, 60px); }
  .gchapter__head {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: 0 18px;
    margin-bottom: clamp(20px, 3vw, 34px);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-soft);
  }
  .gc-num { grid-row: 1; font-family: "Playfair Display", serif; font-size: clamp(26px, 3vw, 40px); color: var(--burgundy); line-height: 1; }
  .gchapter__head h2 { grid-row: 1; font-size: clamp(28px, 3.4vw, 46px); line-height: 1; }
  .gc-count {
    grid-row: 1;
    justify-self: end;
    align-self: center;
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--muted);
  }
  .gc-count::after { content: " ●"; color: var(--burgundy); font-size: 7px; vertical-align: middle; }
  .gc-intro { grid-column: 2 / 4; grid-row: 2; margin: 12px 0 0; font-size: 15px; font-weight: 300; color: var(--ink-2); max-width: 570px; }

  /* Grille uniforme : rangées régulières, aucun vide (seule la dernière rangée
     peut être partielle, ce qui est propre). Pas de spans = pas de bas en dents de scie. */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 10px;
  }
  .tile {
    position: relative;
    min-width: 0;
    padding: 0;
    border: 0;
    margin: 0;
    aspect-ratio: 3 / 2;
    background: var(--bg-deep);
    overflow: hidden;
    cursor: pointer;
    outline-offset: 3px;
  }
  .tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Photo maîtresse pleine largeur en tête de chapitre (bande éditoriale). */
  .tile--lead { aspect-ratio: auto; }
  .tile--lead img { height: clamp(300px, 38vw, 480px); }
  /* Repère d'agrandissement (pas de zoom d'image au survol, tell d'UI générée). */
  .tile__cue {
    position: absolute;
    right: 10px;
    bottom: 9px;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(139, 0, 0, 0.82);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.22s, transform 0.22s;
  }
  .tile__cue i { font-style: normal; font-size: 15px; line-height: 1; }
  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 2px var(--burgundy);
    opacity: 0;
    transition: opacity 0.22s;
  }
  .tile:hover .tile__cue, .tile:focus-visible .tile__cue { opacity: 1; transform: none; }
  .tile:hover::after, .tile:focus-visible::after { opacity: 1; }

  /* Interlettrage ramené à zéro : au-delà de 0,05em sur du texte courant, les
     groupes de lettres se défont et la lecture ralentit. */
  .gallery-hint {
    text-align: center;
    margin: clamp(40px, 6vw, 72px) 0 0;
    font-size: 13px;
    letter-spacing: 0;
    color: var(--muted);
  }

  /* Visionneuse plein écran : tire l'original 2560px à l'ouverture. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(20, 18, 16, 0.96);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox[hidden] { display: none; }
  .lb-stage { margin: 0; max-width: 92vw; max-height: 92vh; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .lb-stage img { max-width: 92vw; max-height: 82vh; object-fit: contain; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5); }
  .lb-stage figcaption {
    display: flex;
    gap: 16px;
    align-items: baseline;
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.72);
  }
  #lbCount { color: var(--gold); }
  .lb-btn {
    position: absolute;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
    font-size: 30px;
    line-height: 1;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .lb-btn:hover { opacity: 1; }
  .lb-close { top: 14px; right: 18px; font-size: 22px; }
  .lb-prev { left: 8px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 8px; top: 50%; transform: translateY(-50%); }

  @media (max-width: 999px) {
    .mosaic { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 639px) {
    .gallery-hero .inner { padding-left: 22px; padding-right: 22px; }
    .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
    .tile--lead img { height: clamp(220px, 55vw, 320px); }
    .gchapter__head { grid-template-columns: auto 1fr; }
    .gc-count { grid-column: 1 / 3; grid-row: 2; justify-self: start; margin-top: 6px; }
    .gc-intro { grid-column: 1 / 3; grid-row: 3; }
    .lb-btn { font-size: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile__cue, .tile::after { transition: none; }
  }
</style>

<script>
  const lb = document.getElementById("lightbox") as HTMLElement | null;
  if (lb) {
    const img = document.getElementById("lbImg") as HTMLImageElement;
    const altEl = document.getElementById("lbAlt") as HTMLElement;
    const countEl = document.getElementById("lbCount") as HTMLElement;
    const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>(".tile"));
    const items = tiles.map((t) => ({ full: t.dataset.full || "", alt: t.dataset.alt || "" }));
    let idx = 0;
    let lastFocus: HTMLElement | null = null;

    const preload = (i: number) => {
      const it = items[i];
      if (it) { const im = new Image(); im.src = it.full; }
    };
    const show = (i: number) => {
      idx = (i + items.length) % items.length;
      const it = items[idx];
      img.src = it.full;
      img.alt = it.alt;
      altEl.textContent = it.alt;
      countEl.textContent = `${idx + 1} / ${items.length}`;
      preload(idx + 1);
      preload(idx - 1);
    };
    const open = (i: number, trigger: HTMLElement) => {
      lastFocus = trigger;
      show(i);
      lb.hidden = false;
      document.body.style.overflow = "hidden";
      (document.getElementById("lbNext") as HTMLElement)?.focus();
      window.huberTrack?.("gallery_open", { index: i + 1 });
    };
    const close = () => {
      lb.hidden = true;
      document.body.style.overflow = "";
      img.src = "";
      lastFocus?.focus();
    };

    tiles.forEach((t, i) => t.addEventListener("click", () => open(i, t)));
    document.getElementById("lbClose")?.addEventListener("click", close);
    document.getElementById("lbPrev")?.addEventListener("click", () => show(idx - 1));
    document.getElementById("lbNext")?.addEventListener("click", () => show(idx + 1));
    lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") show(idx + 1);
      else if (e.key === "ArrowLeft") show(idx - 1);
    });
    // Swipe mobile
    let sx = 0;
    lb.addEventListener("touchstart", (e) => { sx = e.changedTouches[0].clientX; }, { passive: true });
    lb.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 50) show(dx < 0 ? idx + 1 : idx - 1);
    }, { passive: true });
  }

  // Scroll-spy du sommaire : surligne le chapitre visible.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".gallery-nav a"));
  const byId = new Map(links.map((l) => [l.dataset.target, l]));
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((l) => l.classList.remove("active"));
          byId.get(e.target.id)?.classList.add("active");
        }
      });
    },
    { rootMargin: "-45% 0px -50% 0px" }
  );
  document.querySelectorAll(".gchapter").forEach((s) => spy.observe(s));
</script>
