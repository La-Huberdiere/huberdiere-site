---
import s from "../data/settings/index.json";
const nav = s.nav;
---
<header class="site-header" id="siteHeader">
  <a href="/" class="brand">
    <span class="name">{s.brandName}</span>
    <span class="sub">{s.brandSub}</span>
  </a>
  <nav class="nav">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href={s.reserveHref} class="book">{s.reserveLabel}</a>
  </nav>
</header>
