---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
// Réglages + langue passés par Base. On préfixe les liens internes selon la langue
// (FR sans préfixe, EN/IT préfixés), et on affiche le sélecteur de langue.
// En dessous de 1200px, le menu passe en burger (styles dans global.css).
const { settings: s, lang = "fr", langs = [] } = Astro.props;

const localize = (href: string) => {
  if (lang === "fr" || !href || !href.startsWith("/")) return href;
  if (href === "/") return `/${lang}`;
  if (href.startsWith("/#")) return `/${lang}${href.slice(1)}`;
  return `/${lang}${href}`;
};
const homeHref = lang === "fr" ? "/" : `/${lang}`;
---
<header class="site-header" id="siteHeader">
  <a href={homeHref} class="brand" aria-label={s.brandName}>
    <Image src={logo} alt={s.brandName} class="brand-logo" widths={[180, 360]} sizes="180px" loading="eager" />
  </a>
  <button class="menu-toggle" id="menuToggle" aria-label="Menu" aria-expanded="false" aria-controls="siteNav">
    <span></span><span></span><span></span>
  </button>
  <nav class="nav" id="siteNav">
    {s.nav.map((n) => <a href={localize(n.href)}>{n.label}</a>)}
    <a href={localize(s.reserveHref)} class="book">{s.reserveLabel}</a>
    <span class="lang-switch">
      {langs.map((l, i) => (
        <>
          {i > 0 && <span class="sep">·</span>}
          <a href={l.href} class={l.code === lang ? "active" : ""} hreflang={l.code}>{l.label}</a>
        </>
      ))}
    </span>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menuToggle");
  const nav = document.getElementById("siteNav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!open));
    document.getElementById("siteHeader")?.classList.toggle("nav-open", !!open);
  });
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      nav.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
      document.getElementById("siteHeader")?.classList.remove("nav-open");
    })
  );
</script>
