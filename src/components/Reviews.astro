---
// Section avis clients. Ne s'affiche QUE si reviews.items contient de vrais avis.
// Les avis sont traduits par langue (textEn/textIt) ; à défaut, on retombe sur le
// texte FR d'origine. L'intitulé de section et le libellé de note sont localisés.
import reviews from "../data/reviews.json";

const { lang = "fr" } = Astro.props;
const head = (reviews.head as Record<string, { eyebrow: string; title: string }>)[lang] ?? reviews.head.fr;
const items = reviews.items as Array<{
  author: string;
  location?: string;
  source?: string;
  rating?: number | string;
  text: string;
  textEn?: string;
  textIt?: string;
  date?: string;
}>;

// Texte de l'avis dans la langue courante (repli FR).
const quoteText = (r: { text: string; textEn?: string; textIt?: string }) =>
  lang === "en" ? r.textEn ?? r.text : lang === "it" ? r.textIt ?? r.text : r.text;
// Guillemets localisés : « … » (FR/IT), “ … ” (EN).
const q = lang === "en" ? { o: "“", c: "”" } : { o: "« ", c: " »" };

// Notes affichées par source (Booking + Google). Séparateur décimal localisé
// (virgule en FR/IT, point en EN), libellé « avis » traduit.
const ratings = ((reviews as { ratings?: Array<{ source: string; value: string; best: string; count: string }> }).ratings) ?? [];
const reviewWord: Record<string, string> = { fr: "avis", en: "reviews", it: "recensioni" };
const dec = (v: string) => (lang === "en" ? v : v.replace(".", ","));
const ratingLines = ratings.map(
  (r) => `${r.source} ${dec(r.value)}/${r.best} · ${r.count} ${reviewWord[lang] ?? reviewWord.fr}`
);
---
{items.length > 0 && (
  <section class="reviews" id="avis">
    <div class="section-head reveal">
      <span class="section-rule" aria-hidden="true"></span>
      <h2 class="section-title">{head.title}</h2>
      <div class="rating-lines">
        {ratingLines.map((line) => <span class="rating-line">{line}</span>)}
      </div>
    </div>
    <div class="reviews-grid">
      {items.map((r) => (
        <figure class="review-card reveal">
          <blockquote>{q.o}{quoteText(r)}{q.c}</blockquote>
          <figcaption>
            <span class="rv-author">{r.author}</span>
            {r.location && <span class="rv-loc">{r.location}</span>}
            {r.source && <span class="rv-source">{r.source}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .reviews {
    background: var(--cream, #f4f2ec);
    padding: 90px 24px;
  }
  .reviews .section-head { text-align: center; max-width: 720px; margin: 0 auto 48px; }
  .rating-lines {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
  }
  .rating-line {
    font-family: "Montserrat", sans-serif;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: #8b0000;
  }
  .reviews-grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
  }
  .review-card {
    background: #fff;
    border: 1px solid rgba(139, 0, 0, 0.12);
    padding: 32px 30px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .review-card blockquote {
    margin: 0;
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.12rem;
    line-height: 1.6;
    color: #2e3a48;
    font-style: italic;
  }
  .review-card figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: "Montserrat", sans-serif;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: 16px;
  }
  .rv-author { font-weight: 600; color: #212121; font-size: 0.92rem; }
  .rv-loc { color: #646464; font-size: 0.82rem; }
  .rv-source { color: #8b0000; font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; margin-top: 4px; }
</style>
