---
// Carnet de Lodovica : adresses à offrir, page autonome (sans header ni footer du
// site), non listée. Le contenu vient de src/lib/carnet.ts, par langue : l'EN et
// l'IT arriveront en ajoutant leur entrée là-bas, pas ici.
import { CARNET, CARNET_PARTAGE_QUERY, type Lang } from "../lib/carnet";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;
const c = CARNET[lang] ?? CARNET.fr!;

const telHref = (t: string) => "tel:" + t.replace(/[^\d+]/g, "");
const siteHref = (s: string) => "https://" + s;
const siteLabel = (s: string) => s.replace(/^www\./, "");
---

<main class="carnet" lang={lang}>
  <header class="c-head">
    <div class="c-head-text">
      <p class="c-mark">Château de la Huberdière</p>
      <h1>{c.titre}</h1>
      <p class="c-sub">{c.sousTitre}</p>
      <div class="c-actions no-print">
        <button type="button" class="c-btn c-btn-plein" id="carnetOffrir">{c.offrir}</button>
        <button type="button" class="c-btn c-btn-vide" id="carnetImprimer">{c.imprimer}</button>
      </div>
      <p class="c-status no-print" id="carnetStatus" role="status"></p>
      <a class="c-lien-proche no-print" href="#c-proche">{c.proche.lienTete}</a>
    </div>
    <figure class="c-head-photo">
      <img
        src="/images/inline/chateau-exterieur/chateau-exterieur-03.webp"
        srcset="/images/inline/chateau-exterieur/chateau-exterieur-03.webp 1x, /images/inline/chateau-exterieur/chateau-exterieur-03@2x.webp 2x"
        alt="La porte rouge du château, sous le lierre et les sauges en fleur"
        width="800"
        height="1000"
        fetchpriority="high"
      />
    </figure>
  </header>

  <section class="c-mot" aria-label="Le mot de Lodovica et Patrick">
    {c.mot.map((p) => <p>{p}</p>)}
    <div class="c-signe">
      <p class="c-signature">{c.signature}</p>
      <svg class="c-cachet" viewBox="0 0 100 100" aria-hidden="true">
        <defs><path id="c-rond" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0" /></defs>
        <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="2.4" />
        <circle cx="50" cy="50" r="27" fill="none" stroke="currentColor" stroke-width="1.4" />
        <text font-family="Montserrat,sans-serif" font-size="7.3" font-weight="600" fill="currentColor" letter-spacing=".25"><textPath href="#c-rond">POSTÉ AU CHÂTEAU DE LA HUBERDIÈRE · AMBOISE ·</textPath></text>
        <text x="50" y="47" text-anchor="middle" font-family="Playfair Display,Georgia,serif" font-size="11" font-style="italic" fill="currentColor">la maison</text>
        <text x="50" y="60" text-anchor="middle" font-family="Playfair Display,Georgia,serif" font-size="11" font-style="italic" fill="currentColor">poste</text>
      </svg>
    </div>
  </section>

  <section class="c-section" aria-labelledby="c-tables">
    <h2 id="c-tables">{c.tables.titre}</h2>
    <p class="c-intro">{c.tables.intro}</p>
    <div class="c-groupes">
      {c.tables.groupes.map((g) => (
        <div class="c-groupe">
          <h3>{g.titre}</h3>
          <ul class="c-liste">
            {g.adresses.map((a) => (
              <li>
                <span class="c-nom">{a.nom}</span>
                <span class="c-note">{a.note}</span>
                <span class="c-coord">
                  {a.ville && <span>{a.ville}</span>}
                  {a.tel && <a href={telHref(a.tel)}>{a.tel}</a>}
                  {a.site && <a href={siteHref(a.site)} rel="noopener" target="_blank">{siteLabel(a.site)}</a>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="c-a-completer no-print"><strong>{c.aCompleter.etiquette}</strong>{c.aCompleter.producteurs}</p>
  </section>

  <figure class="c-large">
    <img
      src="/images/inline/restauration/restauration-03.webp"
      srcset="/images/inline/restauration/restauration-03.webp 1x, /images/inline/restauration/restauration-03@2x.webp 2x"
      alt="Une table dressée dehors devant le château, nappe blanche et tomates à la mozzarella"
      loading="lazy"
      width="800"
      height="1000"
    />
  </figure>

  <section class="c-section" aria-labelledby="c-activites">
    <h2 id="c-activites">{c.activites.titre}</h2>
    <p class="c-intro">{c.activites.intro}</p>
    <div class="c-activites">
      <ul class="c-liste c-liste-activites">
        {c.activites.liste.map((a) => (
          <li>
            <span class="c-nom">{a.nom}{a.prestataire && <span class="c-presta"> avec {a.prestataire}</span>}</span>
            <span class="c-note">{a.texte}</span>
          </li>
        ))}
      </ul>
      <figure class="c-activites-photo">
        <img
          src="/images/inline/chateau-exterieur/chateau-exterieur-13.webp"
          srcset="/images/inline/chateau-exterieur/chateau-exterieur-13.webp 1x, /images/inline/chateau-exterieur/chateau-exterieur-13@2x.webp 2x"
          alt="Le château de la Huberdière, près d'Amboise, se reflète dans l'étang du parc, en automne"
          loading="lazy"
          width="720"
          height="540"
        />
        <figcaption>L'étang du parc, en automne.</figcaption>
      </figure>
    </div>
    <p class="c-a-completer no-print"><strong>{c.aCompleter.etiquette}</strong>{c.aCompleter.coordonnees}</p>
    <p class="c-a-completer no-print"><strong>{c.aCompleter.etiquette}</strong>{c.aCompleter.saisons}</p>
    <p class="c-a-completer no-print"><strong>{c.aCompleter.etiquette}</strong>{c.aCompleter.pluie}</p>
  </section>

  <!-- Envoi à un proche : maquette pour le client, visible seulement avec ?brouillon.
       Le formulaire n'envoie rien ; le vrai envoi attend l'accord du client et une revue sécurité. -->
  <section class="c-proche no-print" id="c-proche" aria-labelledby="c-proche-titre">
    <div class="c-proche-in">
      <div class="c-proche-texte">
        <h2 id="c-proche-titre">{c.proche.titre}</h2>
        <p>{c.proche.texte}</p>
      </div>
      <form class="c-proche-form" id="carnetProche" novalidate>
        <label class="c-champ">
          <span>{c.proche.prenom}</span>
          <input type="text" name="prenom" autocomplete="given-name" maxlength="40" required />
        </label>
        <label class="c-champ">
          <span>{c.proche.email}</span>
          <input type="email" name="email" autocomplete="off" inputmode="email" maxlength="120" required />
        </label>
        <div class="c-hp" aria-hidden="true">
          <label>Site web <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="c-btn c-btn-creme">{c.proche.bouton}</button>
        <p class="c-promesse">{c.proche.promesse}</p>
        <p class="c-proche-status" id="carnetProcheStatus" role="status"></p>
      </form>
    </div>
  </section>

  <footer class="c-pied">
    <a href="https://www.chateaudelahuberdiere.com/?utm_source=carnet&utm_medium=pied&utm_campaign=satisfaction">{c.pied}</a>
  </footer>
</main>

<script is:inline define:vars={{ query: CARNET_PARTAGE_QUERY, titre: c.partageTitre, texte: c.partageTexte, copie: c.lienCopie, proche: c.proche }}>
  (function () {
    if (new URLSearchParams(location.search).has("brouillon")) {
      document.querySelector(".carnet").classList.add("brouillon");
    }
    var status = document.getElementById("carnetStatus");
    var track = function (name, data) {
      // Jamais window.umami en direct : il est chargé en async, voir Base.astro.
      if (window.huberUmami) window.huberUmami(name, data);
    };
    document.getElementById("carnetOffrir").addEventListener("click", async function () {
      var url = location.origin + location.pathname + "?" + query;
      if (navigator.share) {
        try {
          await navigator.share({ title: titre, text: texte, url: url });
          track("carnet_partage", { methode: "partage" });
          return;
        } catch (e) {
          if (e && e.name === "AbortError") return; // l'utilisateur a refermé la feuille
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = copie;
        track("carnet_partage", { methode: "copie" });
      } catch (e) {
        window.prompt(titre, url);
        track("carnet_partage", { methode: "manuel" });
      }
    });
    document.getElementById("carnetImprimer").addEventListener("click", function () {
      track("carnet_impression");
      window.print();
    });

    // Démonstration : on valide et on montre ce qui partirait, sans rien envoyer.
    var form = document.getElementById("carnetProche");
    var procheStatus = document.getElementById("carnetProcheStatus");
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (form.website.value) return;
      var prenom = form.prenom.value.trim();
      var email = form.email.value.trim();
      var ok = prenom && /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
      procheStatus.classList.toggle("is-erreur", !ok);
      procheStatus.textContent = ok ? proche.demo.replace("{email}", email).replace("{prenom}", prenom) : proche.erreur;
      if (ok) track("carnet_proche_demo");
    });
  })();
</script>

<style>
  .carnet {
    --c-max: 1080px;
    background: var(--bg);
    color: var(--ink);
    padding: 0 0 56px;
  }

  /* Ouverture asymétrique : texte à gauche sur deux tiers, photo verticale qui
     déborde en haut à droite, filet bordeaux sous le titre. */
  .c-head {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 56px;
    max-width: var(--c-max);
    margin: 0 auto;
    padding: 56px 32px 0;
    align-items: end;
  }
  .c-mark {
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    font-size: 17px;
    color: var(--burgundy);
    margin: 0 0 28px;
  }
  .c-head h1 {
    font-size: clamp(42px, 6.4vw, 76px);
    line-height: 1.02;
    margin: 0 0 22px;
    padding-bottom: 22px;
    border-bottom: 2px solid var(--burgundy);
    max-width: 11em;
  }
  .c-sub {
    font-size: 17px;
    line-height: 1.6;
    max-width: 30em;
    color: var(--ink-2);
    margin: 0 0 30px;
  }
  .c-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .c-btn {
    font: 400 14px/1 "Montserrat", sans-serif;
    letter-spacing: 0.02em;
    padding: 16px 26px;
    border: 1px solid var(--burgundy);
    border-radius: 0;
    cursor: pointer;
    min-height: 48px;
  }
  .c-btn-plein { background: var(--burgundy); color: #fff; }
  .c-btn-vide { background: transparent; color: var(--burgundy); }
  .c-btn:hover { background: var(--burgundy-deep); border-color: var(--burgundy-deep); color: #fff; }
  .c-btn:focus-visible { outline: 3px solid var(--ink-2); outline-offset: 3px; }
  .c-status { min-height: 1.6em; margin: 12px 0 0; font-size: 14px; color: var(--ink-2); }
  .c-head-photo { margin: 0; }
  .c-head-photo img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }

  /* Le mot : colonne étroite décalée, filet à gauche. */
  .c-mot {
    max-width: var(--c-max);
    margin: 64px auto 0;
    padding: 0 32px;
  }
  .c-mot p {
    max-width: 34em;
    margin: 0 0 16px 22%;
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink);
  }
  .c-signe { display: flex; align-items: center; gap: 22px; margin: 24px 0 0 22%; }
  .c-mot .c-signature {
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    font-size: 20px;
    color: var(--burgundy);
    margin: 0;
  }
  .c-cachet { width: 92px; height: 92px; flex: none; color: var(--burgundy); transform: rotate(-9deg); opacity: 0.9; }

  .c-lien-proche { display: none; }
  .carnet.brouillon .c-lien-proche {
    display: inline-block;
    margin-top: 0;
    font-size: 14px;
    color: var(--burgundy);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .c-lien-proche:hover { color: var(--burgundy-deep); }

  .c-section { max-width: var(--c-max); margin: 88px auto 0; padding: 0 32px; }
  .c-section h2 {
    font-size: clamp(32px, 4.4vw, 48px);
    padding-top: 18px;
    border-top: 2px solid var(--burgundy);
    margin: 0 0 14px;
  }
  .c-intro { max-width: 36em; margin: 0 0 36px; font-size: 16px; color: var(--ink-2); }

  .c-groupes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 44px 56px; }
  .c-groupe h3 { font-size: 24px; margin: 0 0 8px; color: var(--burgundy); }
  .c-liste { list-style: none; margin: 0; padding: 0; }
  .c-liste li {
    display: grid;
    gap: 2px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    break-inside: avoid;
  }
  .c-nom { font-family: "Playfair Display", Georgia, serif; font-size: 19px; line-height: 1.3; color: var(--ink); }
  .c-presta { font-family: "Montserrat", sans-serif; font-size: 15px; color: var(--burgundy); }
  .c-note { font-size: 14.5px; line-height: 1.55; color: var(--ink-2); }
  .c-coord { display: flex; flex-wrap: wrap; gap: 2px 16px; font-size: 13.5px; color: var(--muted); }
  .c-coord a { color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .c-coord a:hover { color: var(--burgundy); text-decoration-color: var(--burgundy); }
  .c-liste-activites { max-width: 46em; }
  .c-activites { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 56px; align-items: start; }
  .c-activites-photo { margin: 0; position: sticky; top: 32px; }
  .c-activites-photo img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .c-activites-photo figcaption {
    margin-top: 10px;
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    font-size: 15px;
    color: var(--ink-2);
  }

  /* Parlez-en à un proche : bande bordeaux pleine largeur, maquette en ?brouillon. */
  .c-proche { display: none; }
  .carnet.brouillon .c-proche { display: block; margin: 96px 0 0; padding: 0; background: var(--burgundy); color: #fff; scroll-margin-top: 24px; }
  .c-proche-in {
    max-width: var(--c-max);
    margin: 0 auto;
    padding: 64px 32px 60px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 56px;
    align-items: start;
  }
  .c-proche h2 {
    color: #fff;
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.08;
    margin: 0 0 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }
  .c-proche-texte p { margin: 0; max-width: 26em; font-size: 17px; line-height: 1.65; color: #fff; }
  .c-proche-form { display: grid; gap: 16px; }
  .c-champ { display: grid; gap: 6px; }
  .c-champ span { font-size: 14px; color: #fff; }
  .c-champ input {
    font: 400 16px/1.3 "Montserrat", sans-serif;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--bg);
    border-radius: 0;
    padding: 13px 14px;
    min-height: 48px;
  }
  .c-champ input:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .c-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .c-btn-creme { justify-self: start; background: var(--bg); color: var(--burgundy); border-color: var(--bg); }
  .c-proche .c-btn-creme:hover { background: #fff; border-color: #fff; color: var(--burgundy-deep); }
  .c-proche .c-btn:focus-visible { outline-color: #fff; }
  .c-promesse { margin: 0; font-size: 13.5px; line-height: 1.55; color: rgba(255, 255, 255, 0.88); max-width: 34em; }
  .c-proche-status:empty { display: none; }
  .c-proche-status {
    margin: 4px 0 0;
    padding: 12px 14px;
    border: 1px dashed rgba(255, 255, 255, 0.75);
    font-size: 14.5px;
    line-height: 1.5;
    color: #fff;
  }
  .c-proche-status.is-erreur { border-style: solid; font-weight: 500; }
  .carnet :global(::selection) { background: var(--burgundy); color: #fff; }
  .c-proche :global(::selection) { background: var(--bg); color: var(--burgundy); }

  /* Photo pleine largeur, coupe le texte entre les deux grandes parties. */
  .c-large { margin: 88px 0 0; }
  .c-large img { width: 100%; height: clamp(260px, 46vw, 520px); object-fit: cover; object-position: 50% 78%; }

  /* Trou à faire combler : discret, dans l'esprit d'une note marginale. */
  /* Notes de travail pour Lodovica : visibles seulement en démo, /carnet?brouillon */
  .c-a-completer { display: none; }
  .carnet.brouillon .c-a-completer {
    display: block;
    max-width: 46em;
    margin: 22px 0 0;
    padding: 10px 16px;
    border-left: 2px dashed var(--burgundy);
    background: var(--bg-deep);
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .c-a-completer strong { display: block; font-weight: 500; color: var(--burgundy); }

  .c-pied { max-width: var(--c-max); margin: 88px auto 0; padding: 22px 32px 0; border-top: 1px solid var(--line); font-size: 14px; }
  .c-pied a { color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }

  @media (max-width: 760px) {
    .c-head { grid-template-columns: 1fr; gap: 32px; padding: 32px 20px 0; }
    .c-head-photo { order: -1; }
    .c-head-photo img { aspect-ratio: 5 / 4; }
    .c-mark { margin-bottom: 14px; }
    .c-mot { padding: 0 20px; margin-top: 44px; }
    .c-mot p { margin-left: 0; }
    .c-signe { margin-left: 0; gap: 18px; }
    .c-cachet { width: 76px; height: 76px; }
    .c-activites { grid-template-columns: 1fr; gap: 28px; }
    .c-activites-photo { position: static; }
    .carnet.brouillon .c-proche { margin-top: 72px; }
    .c-proche-in { grid-template-columns: 1fr; gap: 28px; padding: 48px 20px 44px; }
    .c-btn-creme { justify-self: stretch; }
    .c-section { padding: 0 20px; margin-top: 64px; }
    .c-groupes { grid-template-columns: 1fr; gap: 36px; }
    .c-large { margin-top: 64px; }
    .c-pied { padding: 22px 20px 0; margin-top: 64px; }
    .c-btn { flex: 1 1 100%; }
  }

  /* Impression : A4, sans bouton, sans encart à compléter ; les adresses sur deux
     colonnes, les liens écrits en clair. */
  @media print {
    @page { size: A4; margin: 14mm; }
    .no-print { display: none !important; }
    .carnet { background: #fff; padding: 0; }
    .c-head, .c-mot, .c-section, .c-pied { max-width: none; padding-left: 0; padding-right: 0; }
    .c-head { grid-template-columns: 1fr 52mm; gap: 12mm; padding-top: 0; }
    .c-head h1 { font-size: 30pt; padding-bottom: 8pt; }
    .c-sub { font-size: 10.5pt; margin: 0; }
    .c-mark { font-size: 10pt; margin-bottom: 8pt; }
    .c-head-photo img { aspect-ratio: 4 / 5; }
    .c-mot { margin-top: 10mm; }
    .c-mot p { margin-left: 0; max-width: none; font-size: 10pt; line-height: 1.55; }
    .c-section { margin-top: 9mm; }
    .c-section h2 { font-size: 20pt; margin-bottom: 4pt; }
    .c-intro { font-size: 9.5pt; margin-bottom: 5mm; }
    .c-groupes { display: block; columns: 2; column-gap: 9mm; }
    .c-groupe { break-inside: avoid-column; margin-bottom: 5mm; }
    .c-groupe h3 { font-size: 13pt; }
    .c-liste li { padding: 5pt 0; }
    .c-nom { font-size: 10.5pt; }
    .c-note, .c-coord { font-size: 8.5pt; }
    .c-coord a { text-decoration: none; color: var(--ink-2); }
    .c-liste-activites { max-width: none; columns: 2; column-gap: 9mm; }
    .c-large, .c-activites-photo { display: none; }
    .c-activites { display: block; }
    .c-signe { margin-left: 0; }
    .c-cachet { width: 20mm; height: 20mm; }
    :global(.cookie-banner), :global(.pv-lightbox) { display: none !important; }
    :global(body) { background: #fff; }
    .c-pied { margin-top: 8mm; font-size: 8.5pt; }
    h2, h3 { break-after: avoid; }
  }
</style>
