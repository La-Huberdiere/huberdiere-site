---
// Réglages + langue passés par Base. NAP canonique (corrigé dans l'audit SEO).
import NewsletterSignup from "./NewsletterSignup.astro";
import { localizePath } from "../lib/routes";
const { settings: s, lang = "fr" } = Astro.props;
const f = s.footer;

const localize = (href: string) => localizePath(href, lang as "fr" | "en" | "it");

// L'année du copyright était figée à 2026 dans les trois langues des réglages :
// au 1er janvier, le site affiche une année périmée sur toutes ses pages, et
// personne n'y pense. Elle est recalculée à la construction, la chaîne reste
// éditable au CMS pour tout le reste.
const bottomLeft = String(f.bottomLeft ?? "").replace(/©\s*\d{4}/, `© ${new Date().getFullYear()}`);

// Liens légaux : pages FR/EN/IT, libellés et URL localisés.
const legalLabels = {
  fr: { ml: "Mentions légales", pc: "Politique de confidentialité" },
  en: { ml: "Legal notice", pc: "Privacy policy" },
  it: { ml: "Note legali", pc: "Informativa privacy" },
}[lang as "fr" | "en" | "it"];

// Crédit de conception (visible, assumé). Ancre = nom propre, pas mot-clé.
const creditLabel = {
  fr: "Conception et référencement",
  en: "Design and SEO",
  it: "Design e SEO",
}[lang as "fr" | "en" | "it"];
---
<NewsletterSignup lang={lang} />
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <div class="name">{f.name}</div>
      <p>{f.addressLine1}</p>
      <p>{f.addressLine2}</p>
      <p><a href={`tel:${f.phoneHref}`}>{f.phone}</a></p>
      <p><a href={`mailto:${f.email}`}>{f.email}</a></p>
    </div>
    <div>
      <h3>{f.col2Title}</h3>
      <ul>
        {f.col2Links.map((l) => <li><a href={localize(l.href)}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h3>{f.col3Title}</h3>
      <ul>
        {f.col3Links.map((l) => <li><a href={localize(l.href)}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <nav class="footer-legal" aria-label="Liens légaux">
    <a href={localize("/mentions-legales")}>{legalLabels.ml}</a>
    <span class="sep">·</span>
    <a href={localize("/politique-de-confidentialite")}>{legalLabels.pc}</a>
  </nav>
  <div class="footer-bottom">
    <span>{bottomLeft}</span>
    <span>{f.bottomRight}</span>
  </div>
  <div class="footer-credit">
    <span>{creditLabel} : <a href="https://alexis.morain.fr" target="_blank" rel="noopener">Alexis Morain</a></span>
  </div>
</footer>

<style>
  .footer-legal {
    max-width: 1180px;
    margin: 0 auto;
    padding: 8px 24px 0;
    font-family: "Montserrat", sans-serif;
    font-size: 0.78rem;
  }
  .footer-legal a { color: inherit; opacity: 0.85; text-decoration: none; }
  .footer-legal a:hover { opacity: 1; text-decoration: underline; }
  .footer-legal .sep { opacity: 0.5; margin: 0 8px; }
  .footer-credit {
    max-width: 1280px;
    margin: 14px auto 0;
    padding: 0 24px;
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    letter-spacing: 0.05em;
    opacity: 0.4;
  }
  .footer-credit a { color: inherit; text-decoration: none; }
  .footer-credit a:hover { opacity: 1; text-decoration: underline; }
</style>
