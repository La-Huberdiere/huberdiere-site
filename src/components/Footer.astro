---
// Réglages + langue passés par Base. NAP canonique (corrigé dans l'audit SEO).
const { settings: s, lang = "fr" } = Astro.props;
const f = s.footer;

const localize = (href: string) => {
  if (lang === "fr" || !href || !href.startsWith("/")) return href;
  if (href === "/") return `/${lang}`;
  if (href.startsWith("/#")) return `/${lang}${href.slice(1)}`;
  return `/${lang}${href}`;
};
---
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <div class="name">{f.name}</div>
      <p>{f.addressLine1}</p>
      <p>{f.addressLine2}</p>
      <p><a href={`tel:${f.phoneHref}`}>{f.phone}</a></p>
      <p><a href={`mailto:${f.email}`}>{f.email}</a></p>
    </div>
    <div>
      <h4>{f.col2Title}</h4>
      <ul>
        {f.col2Links.map((l) => <li><a href={localize(l.href)}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>{f.col3Title}</h4>
      <ul>
        {f.col3Links.map((l) => <li><a href={localize(l.href)}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>{f.bottomLeft}</span>
    <span>{f.bottomRight}</span>
  </div>
</footer>
