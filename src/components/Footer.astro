---
// Contenu éditable dans Keystatic → Réglages du site (header & footer).
// NAP canonique (corrigé dans l'audit SEO) : un seul bloc cohérent.
import s from "../data/settings/index.json";
const f = s.footer;
---
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <div class="name">{f.name}</div>
      <p>{f.addressLine1}</p>
      <p>{f.addressLine2}</p>
      <p><a href={`tel:${f.phoneHref}`}>{f.phone}</a></p>
      <p><a href={`mailto:${f.email}`}>{f.email}</a></p>
    </div>
    <div>
      <h4>{f.col2Title}</h4>
      <ul>
        {f.col2Links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>{f.col3Title}</h4>
      <ul>
        {f.col3Links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>{f.bottomLeft}</span>
    <span>{f.bottomRight}</span>
  </div>
</footer>
