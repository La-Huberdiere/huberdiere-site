---
// Bannière de consentement RGPD. Pilote le Consent Mode v2 (défini dans Base.astro).
// Refus par défaut : rien n'est tracké tant que l'utilisateur n'a pas accepté.
const { lang = "fr" } = Astro.props;
// Texte éditable depuis Keystatic (singleton « Textes du site »).
import siteTexts from "../data/site-texts.json";
const t = ((siteTexts as any)[lang] ?? (siteTexts as any).fr).cookies;
const policyHref = "/politique-de-confidentialite";
---

<div id="cookieBanner" class="cookie-banner" role="dialog" aria-live="polite" aria-label="Consentement cookies" hidden>
  <p class="cookie-text">
    {t.text} <a href={policyHref}>{t.link}</a>
  </p>
  <div class="cookie-actions">
    <button type="button" id="cookieRefuse" class="cookie-btn ghost">{t.refuse}</button>
    <button type="button" id="cookieAccept" class="cookie-btn solid">{t.accept}</button>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById("cookieBanner");
    if (!banner) return;
    var KEY = "huber-consent";
    var choice = null;
    try { choice = localStorage.getItem(KEY); } catch (e) {}
    if (!choice) banner.hidden = false;

    function gtag() { window.dataLayer = window.dataLayer || []; window.dataLayer.push(arguments); }

    function set(granted) {
      try { localStorage.setItem(KEY, granted ? "granted" : "denied"); } catch (e) {}
      gtag("consent", "update", {
        ad_storage: granted ? "granted" : "denied",
        ad_user_data: granted ? "granted" : "denied",
        ad_personalization: granted ? "granted" : "denied",
        analytics_storage: granted ? "granted" : "denied",
      });
      banner.hidden = true;
    }
    document.getElementById("cookieAccept").addEventListener("click", function () { set(true); });
    document.getElementById("cookieRefuse").addEventListener("click", function () { set(false); });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    /* Ancré à droite, pas centré : centré et large de 720 px, il se posait pile sur
       la barre de recherche Octorate, qui fait la même largeur sur le même axe.
       Tout nouveau visiteur voyait le seul élément transactionnel de la home masqué. */
    left: auto;
    right: 16px;
    bottom: 16px;
    z-index: 9999;
    max-width: 420px;
    margin: 0;
    background: #fffdf9;
    /* Filet bordeaux en tête plutôt qu'un liseré fin noyé dans une ombre large :
       même traitement que la carte du moteur de réservation, et la charte
       demande des filets de marque, pas des cartes qui flottent. */
    border: 0;
    border-top: 2px solid #8b0000;
    border-radius: 0;
    box-shadow: 0 6px 16px rgba(33, 33, 33, 0.26);
    padding: 18px 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    font-family: "Montserrat", sans-serif;
  }
  /* Sans cette règle, le display:flex ci-dessus écrase le [hidden] du navigateur
     et la bannière reste affichée même après un clic Accepter/Refuser. */
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-text {
    margin: 0;
    flex: 1 1 320px;
    font-size: 0.86rem;
    line-height: 1.55;
    color: #2e3a48;
  }
  .cookie-text a { color: #8b0000; }
  .cookie-actions { display: flex; gap: 10px; margin-left: auto; }
  .cookie-btn {
    cursor: pointer;
    border-radius: 0;
    padding: 10px 20px;
    font-family: "Montserrat", sans-serif;
    font-size: 0.84rem;
    letter-spacing: 0.02em;
    border: 1px solid #8b0000;
    transition: opacity 0.15s ease;
  }
  .cookie-btn.solid { background: #8b0000; color: #fff; }
  .cookie-btn.ghost { background: transparent; color: #8b0000; }
  .cookie-btn:hover { opacity: 0.85; }
  /* La barre d'action fixe (StickyCta) occupe 52 px en bas d'écran sous 960 px :
     le bandeau remonte au-dessus d'elle plutôt que de la recouvrir. */
  @media (max-width: 960px) {
    :global(html.sticky-cta-on) .cookie-banner {
      bottom: calc(68px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (max-width: 560px) {
    /* Sous 560 px il n'y a plus de place pour un encart de côté : la bannière
       reprend toute la largeur, mais reste en bas et hors de la barre Octorate. */
    .cookie-banner { left: 16px; right: 16px; max-width: none; }
    .cookie-actions { width: 100%; }
    .cookie-btn { flex: 1; }
  }
</style>
