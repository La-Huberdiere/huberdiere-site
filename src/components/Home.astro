---
import { Image } from "astro:assets";
import BookingBar from "./BookingBar.astro";
import settings from "../data/settings.json";
import hero from "../assets/SD_2.jpg";
import intro from "../assets/SD_1.jpg";
import actSejour from "../assets/SD_23.jpg";
import actMariage from "../assets/SD_6.jpg";
import actSeminaire from "../assets/SD_8.jpg";
import actFamille from "../assets/SD_7.jpg";
import actRetraite from "../assets/SD_10.jpg";
import g1 from "../assets/SD_3.jpg";
import g2 from "../assets/SD_4.jpg";
import g3 from "../assets/SD_9.jpg";
import g4 from "../assets/SD_11.jpg";
import g5 from "../assets/BD_1.jpg";
import g6 from "../assets/SD_5.jpg";
import loc from "../assets/BD_5.jpg";

// Contenu (textes) passé en props selon la langue ; images partagées et optimisées.
const { c, lang = "fr" } = Astro.props;
const booking = settings[lang].booking;
const actImages = [actSejour, actMariage, actSeminaire, actFamille, actRetraite];
const actAlts = [
  "Chambre du château aux murs poudrés",
  "Entrée fleurie du château aux beaux jours",
  "Salle de travail aux boiseries d'époque",
  "Grand salon du château avec cheminée",
  "Salon lumineux et chaises en rotin",
];
const actIds = ["sejour", "mariage", "seminaire", "famille", "retraite"];
---

<!-- HERO -->
<section class="hero" id="hero">
  <Image src={hero} alt="Château de la Huberdière vu depuis l'étang" widths={[768, 1280, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="hero-content">
    <div class="eyebrow">{c.hero.eyebrow}</div>
    <h1>{c.hero.titleLine1}<br /><span class="italic">{c.hero.titleLine2Italic}</span></h1>
    <p class="lead">{c.hero.lead}</p>
    <div class="hero-cta">
      <a class="btn-primary" href="#final">{c.hero.ctaPrimary}</a>
      <a class="btn-ghost" href="#acts">{c.hero.ctaSecondary}</a>
    </div>
    <BookingBar booking={booking} lang={lang} />
  </div>
</section>

<!-- INTRO -->
<section class="intro">
  <div class="container">
    <div class="text reveal">
      <span class="section-eyebrow">{c.intro.eyebrow}</span>
      <h2>{c.intro.titleLine1}<br /><span class="italic">{c.intro.titleLine2Italic}</span></h2>
      {c.intro.paragraphs.map((p) => <p>{p}</p>)}
      <div class="sign">{c.intro.sign}</div>
    </div>
    <div class="visual reveal">
      <Image src={intro} alt="Façade du château et son escalier en balustrade" widths={[500, 900, 1200]} sizes="(max-width:960px) 100vw, 45vw" />
    </div>
  </div>
</section>

<div class="ornament">La Huberdière</div>

<!-- ACTIVITES -->
<section class="acts" id="acts">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-eyebrow">{c.activitiesHead.eyebrow}</span>
      <h2 class="section-title">{c.activitiesHead.titlePlain}<span class="italic">{c.activitiesHead.titleItalic}</span></h2>
      <p>{c.activitiesHead.intro}</p>
    </div>

    <div class="acts-grid">
      {
        c.activities.map((a, i) => (
          <article class="act reveal" id={actIds[i]}>
            <div class="act-visual">
              <Image src={actImages[i]} alt={actAlts[i]} widths={[600, 900, 1200]} sizes="(max-width:960px) 100vw, 45vw" />
            </div>
            <div class="act-text">
              <div class="num">{a.num}</div>
              <h3>{a.titlePlain}<span class="italic">{a.titleItalic}</span></h3>
              <p>{a.text}</p>
              <ul class="list">
                {a.points.map((pt) => <li>{pt}</li>)}
              </ul>
              <a href={a.linkHref} class="act-link">{a.linkLabel}</a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- QUOTE -->
<section class="quote">
  <blockquote class="reveal">
    « {c.quote.text} »
    <cite>{c.quote.cite}</cite>
  </blockquote>
</section>

<!-- GALERIE -->
<section class="gallery" id="galerie">
  <div class="section-head reveal">
    <span class="section-eyebrow">{c.galleryHead.eyebrow}</span>
    <h2 class="section-title">{c.galleryHead.titlePlain}<span class="italic">{c.galleryHead.titleItalic}</span></h2>
  </div>
  <div class="gallery-grid">
    <figure class="g1 reveal"><Image src={g1} alt="Façade et cour du château" widths={[600, 1000, 1400]} sizes="50vw" /></figure>
    <figure class="g2 reveal"><Image src={g2} alt="Piscine et parasols dans le parc" widths={[600, 1000, 1400]} sizes="50vw" /></figure>
    <figure class="g3 reveal"><Image src={g3} alt="Salle à manger aux boiseries" widths={[400, 700, 900]} sizes="40vw" /></figure>
    <figure class="g4 reveal"><Image src={g4} alt="Salon avec cheminée de marbre" widths={[300, 500, 700]} sizes="25vw" /></figure>
    <figure class="g5 reveal"><Image src={g5} alt="Table dressée en terrasse" widths={[400, 700, 900]} sizes="40vw" /></figure>
    <figure class="g6 reveal"><Image src={g6} alt="Piscine et jardins du domaine" widths={[600, 1000, 1400]} sizes="60vw" /></figure>
  </div>
</section>

<!-- LOCATION -->
<section class="location" id="location">
  <div class="container">
    <div class="text reveal">
      <span class="section-eyebrow">{c.location.eyebrow}</span>
      <h2>{c.location.titleLine1Plain}<span class="italic">{c.location.titleLine1Italic}</span><br />{c.location.titleLine2}</h2>
      {c.location.paragraphs.map((p) => <p>{p}</p>)}
      <div class="pins">
        {c.location.pins.map((pin) => (
          <div class="pin"><div class="big">{pin.big}</div><div class="lbl">{pin.lbl}</div></div>
        ))}
      </div>
    </div>
    <div class="visual reveal">
      <Image src={loc} alt="Les jardins du château" widths={[500, 900, 1200]} sizes="(max-width:960px) 100vw, 45vw" />
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="final" id="final">
  <span class="section-eyebrow">{c.final.eyebrow}</span>
  <h2 class="reveal">{c.final.titleLine1}<br /><span class="italic">{c.final.titleLine2Italic}</span></h2>
  <p class="reveal">{c.final.text}</p>
  <div class="final-cta reveal">
    <a class="btn-burgundy" href="mailto:contact@chateaudelahuberdiere.com">{c.final.ctaPrimary}</a>
    <a class="btn-ghost" style="color:var(--ink);border-color:var(--ink)" href="tel:+33247575292">{c.final.ctaSecondary}</a>
  </div>
  <div class="response-line reveal">{c.final.responseLine}</div>
</section>
