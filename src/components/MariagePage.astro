---
import { Image } from "astro:assets";
import pHero from "../assets/SD_5.jpg";
import v1 from "../assets/SD_6.jpg";
import v2 from "../assets/SD_9.jpg";
import { reader } from "../lib/content";
import { octorateUrl } from "../lib/octorate";
import { landingMedia } from "../lib/landingMedia";

// Textes en props selon la langue ; image de hero variable par activité.
const { m, cible = "mariage", heroImg } = Astro.props;
const hero = heroImg ?? pHero;
// Photos cohérentes avec la cible (héros + galerie éditoriale) ; fallback sur les
// visuels génériques importés si la cible n'a pas de set dédié.
const media = landingMedia[cible];

const lang = (Astro.currentLocale as "fr" | "en" | "it") ?? "fr";

// Libellés des champs pratiques d'une chambre (lit, étage, orientation, clim, salle
// de bain, vue) + textes de la section chambres, localisés. Les valeurs, elles,
// vivent dans les données (traduites) ; ici on ne traduit que les étiquettes d'UI.
const roomLabels = {
  fr: { bed: "Lit", floor: "Étage", orientation: "Orientation", ac: "Climatisation", bathroom: "Salle de bain", view: "Vue", amenities: "Équipements", noAc: "Sans climatisation", note: "À savoir", cta: "Vérifier les disponibilités", ctaHint: "Consultation libre : vous n'indiquez vos dates qu'au moment de réserver.", ctaLead: "Une chambre vous plaît ? Vérifiez les disponibilités et réservez en ligne.", prev: "Photo précédente", next: "Photo suivante", photo: "photo", goTo: "Aller à la photo" },
  en: { bed: "Bed", floor: "Floor", orientation: "Aspect", ac: "Air conditioning", bathroom: "Bathroom", view: "View", amenities: "Amenities", noAc: "No air conditioning", note: "Good to know", cta: "Check availability", ctaHint: "Browse freely: you only enter your dates when you book.", ctaLead: "Found a room you like? Check availability and book online.", prev: "Previous photo", next: "Next photo", photo: "photo", goTo: "Go to photo" },
  it: { bed: "Letto", floor: "Piano", orientation: "Esposizione", ac: "Aria condizionata", bathroom: "Bagno", view: "Vista", amenities: "Servizi", noAc: "Senza aria condizionata", note: "Da sapere", cta: "Verifica le disponibilità", ctaHint: "Consultazione libera: le date si inseriscono solo al momento della prenotazione.", ctaLead: "Una camera ti piace? Verifica le disponibilità e prenota online.", prev: "Foto precedente", next: "Foto successiva", photo: "foto", goTo: "Vai alla foto" },
}[lang];
const reserveLink = octorateUrl();

// Optimisation images chambres : version WebP servie en priorité (fallback JPEG),
// et texte alt descriptif (nom de chambre + château) pour le SEO/GEO local.
const webpOf = (p: string) => p.replace(/\.(jpe?g|png)$/i, ".webp");
const roomAlt = (name: string, idx: number) =>
  idx === 0
    ? `Chambre ${name}, Château de la Huberdière`
    : `Chambre ${name} · ${roomLabels.photo} ${idx + 1}`;

// Maillage réciproque : la page argent renvoie vers les articles du blog liés
// (le blog est FR seulement, on n'affiche le bloc que sur les pages FR).
const relatedMap: Record<string, string[]> = {
  mariage: ["organiser-mariage-au-chateau", "visiter-chateaux-de-la-loire"],
  sejour: ["chambres-hotes-amboise-chateau", "visiter-chateaux-de-la-loire"],
  retraite: ["organiser-retraite-yoga-chateau", "visiter-chateaux-de-la-loire"],
  famille: ["chambres-hotes-amboise-chateau", "visiter-chateaux-de-la-loire"],
  seminaire: ["visiter-chateaux-de-la-loire", "chambres-hotes-amboise-chateau"],
  restauration: ["chambres-hotes-amboise-chateau", "visiter-chateaux-de-la-loire"],
};
let related: { slug: string; title: string }[] = [];
if (lang === "fr") {
  const slugs = relatedMap[cible] ?? [];
  const entries = await Promise.all(
    slugs.map(async (s) => {
      const e = await reader.collections.articles.read(s);
      return e ? { slug: s, title: e.title } : null;
    })
  );
  related = entries.filter((e): e is { slug: string; title: string } => e !== null);
}
const thanksPath = lang === "fr" ? "/merci" : `/${lang}/merci`;
---

<section class="page-hero">
  {media?.hero ? (
    <picture class="page-hero__pic">
      <source srcset={webpOf(media.hero)} type="image/webp" />
      <img src={media.hero} alt={m.hero.titleLine1} loading="eager" fetchpriority="high" decoding="async" />
    </picture>
  ) : (
    <Image quality={68} src={hero} alt={m.hero.titleLine1} widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  )}
  <div class="inner">
    <div class="eyebrow">{m.hero.eyebrow}</div>
    <h1>{m.hero.titleLine1}<br /><span class="italic">{m.hero.titleLine2Italic}</span></h1>
    <p>{m.hero.lead}</p>
  </div>
</section>

{m.stats && m.stats.length > 0 && (
  <section class="stats-band">
    <div class="stats-row">
      {m.stats.map((s) => (
        <div class="stat reveal">
          <div class="big">{s.big}</div>
          <div class="lbl">{s.lbl}</div>
        </div>
      ))}
    </div>
  </section>
)}

<section>
  <div class="prose reveal">
    {m.intro.map((p) => <p>{p}</p>)}
  </div>
</section>

<section style="padding-top:0">
  <div class="offer-list">
    {m.cards.map((card) => (
      <div class="offer-row reveal">
        <div class="offer-num">{card.num}</div>
        <div class="offer-body">
          <h2>{card.title}</h2>
          <p>{card.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

{m.extras && m.extras.length > 0 && (
  <section class="extras">
    <div class="extras-head reveal">
      {m.extrasHead?.eyebrow && <span class="section-eyebrow">{m.extrasHead.eyebrow}</span>}
      {m.extrasHead?.title && <h2 class="section-title">{m.extrasHead.title}</h2>}
    </div>
    <div class="extras-grid">
      {m.extras.map((e) => (
        <div class="extra-card reveal">
          <h3>{e.title}</h3>
          <p>{e.text}</p>
        </div>
      ))}
    </div>
  </section>
)}

{m.activities && m.activities.length > 0 && (
  <section class="activities">
    <div class="extras-head reveal">
      {m.activitiesHead?.eyebrow && <span class="section-eyebrow">{m.activitiesHead.eyebrow}</span>}
      {m.activitiesHead?.title && <h2 class="section-title">{m.activitiesHead.title}</h2>}
      {m.activitiesHead?.intro && <p class="activities-intro">{m.activitiesHead.intro}</p>}
    </div>
    <div class="activities-list">
      {m.activities.map((a) => (
        <div class="activity-item reveal">
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </div>
      ))}
    </div>
  </section>
)}

{m.rooms && m.rooms.length > 0 && (
  <section class="rooms">
    <div class="extras-head reveal">
      {m.roomsHead?.eyebrow && <span class="section-eyebrow">{m.roomsHead.eyebrow}</span>}
      {m.roomsHead?.title && <h2 class="section-title">{m.roomsHead.title}</h2>}
    </div>
    <div class="rooms-list">
      {m.rooms.map((r, i) => {
        const fields = [
          ["bed", r.bed], ["floor", r.floor], ["orientation", r.orientation],
          ["ac", r.ac], ["bathroom", r.bathroom], ["view", r.view],
        ].filter(([, v]) => v && String(v).trim());
        const photos = (r.photos ?? []).filter((p: string) => p && String(p).trim());
        return (
          <article class={`room-card reveal${i % 2 === 1 ? " room-card--reverse" : ""}${photos.length ? "" : " room-card--nomedia"}`}>
            {photos.length === 1 && (
              <figure class="room-card__media">
                <picture>
                  <source srcset={webpOf(photos[0])} type="image/webp" />
                  <img src={photos[0]} alt={roomAlt(r.name, 0)} loading="lazy" decoding="async" />
                </picture>
              </figure>
            )}
            {photos.length > 1 && (
              <div class="room-card__media room-gallery" data-gallery>
                <div class="room-gallery__track">
                  {photos.map((src: string, idx: number) => (
                    <figure class="room-gallery__slide">
                      <picture>
                        <source srcset={webpOf(src)} type="image/webp" />
                        <img src={src} alt={roomAlt(r.name, idx)} loading="lazy" decoding="async" />
                      </picture>
                    </figure>
                  ))}
                </div>
                <button class="room-gallery__nav room-gallery__nav--prev" type="button" aria-label={roomLabels.prev}>&#8249;</button>
                <button class="room-gallery__nav room-gallery__nav--next" type="button" aria-label={roomLabels.next}>&#8250;</button>
                <div class="room-gallery__dots">
                  {photos.map((_: string, idx: number) => (
                    <button class="room-gallery__dot" type="button" aria-label={`${roomLabels.goTo} ${idx + 1}`} data-idx={idx}></button>
                  ))}
                </div>
              </div>
            )}
            <div class="room-card__body">
              <div class="room-card__head">
                {r.tag && <span class="section-eyebrow">{r.tag}</span>}
                <h3>{r.name}</h3>
                {r.size && <span class="room-size">{r.size}</span>}
              </div>
              {fields.length > 0 && (
                <dl class="room-fields">
                  {fields.map(([key, val]) => (
                    <div class="room-field">
                      <dt>{roomLabels[key as keyof typeof roomLabels]}</dt>
                      <dd>{val}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {!(r.ac && String(r.ac).trim()) && (
                <p class="room-fine">{roomLabels.noAc}</p>
              )}
              {r.amenities && r.amenities.trim() && (
                <p class="room-amenities"><span>{roomLabels.amenities}</span>{r.amenities}</p>
              )}
              {r.text && <p class="room-desc">{r.text}</p>}
              {r.note && r.note.trim() && (
                <p class="room-know"><span>{roomLabels.note}</span>{r.note}</p>
              )}
            </div>
          </article>
        );
      })}
    </div>
    <div class="rooms-cta">
      <p>{roomLabels.ctaLead}</p>
      <a href={reserveLink} class="btn-burgundy" target="_blank" rel="noopener">{roomLabels.cta}</a>
      <span class="rooms-cta__hint">{roomLabels.ctaHint}</span>
    </div>
  </section>
)}

{m.testimonial && m.testimonial.text && (
  <section class="testimonial">
    <blockquote class="reveal">
      <p>{m.testimonial.text}</p>
      <cite>{m.testimonial.author}</cite>
    </blockquote>
  </section>
)}

{m.faq && m.faq.length > 0 && (
  <section class="faq">
    <div class="extras-head reveal">
      {m.faqHead?.eyebrow && <span class="section-eyebrow">{m.faqHead.eyebrow}</span>}
      {m.faqHead?.title && <h2 class="section-title">{m.faqHead.title}</h2>}
    </div>
    <div class="faq-list">
      {m.faq.map((f) => (
        <details class="faq-item reveal">
          <summary>{f.q}</summary>
          <div class="faq-answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </section>
)}

{media?.gallery?.length ? (
  <section class="gallery">
    <div class="landing-gallery">
      {media.gallery.map((src, i) => (
        <figure class="reveal">
          <picture>
            <source srcset={webpOf(src)} type="image/webp" />
            <img src={src} alt={`${m.hero.titleLine1} · ${i + 1}`} loading="lazy" decoding="async" />
          </picture>
        </figure>
      ))}
    </div>
  </section>
) : (
  <section class="gallery">
    <div class="gallery-grid" style="grid-template-columns:repeat(2,1fr);grid-auto-rows:300px">
      <figure class="reveal" style="grid-column:1/2;grid-row:1/2"><Image quality={68} src={v1} alt="Entrée fleurie du château" widths={[600, 1000, 1400]} sizes="50vw" /></figure>
      <figure class="reveal" style="grid-column:2/3;grid-row:1/2"><Image quality={68} src={v2} alt="Grande salle dressée pour un dîner" widths={[600, 1000, 1400]} sizes="50vw" /></figure>
    </div>
  </section>
)}

{related.length > 0 && (
  <section class="related-reads">
    <div class="extras-head reveal">
      <span class="section-eyebrow">À lire</span>
      <h2 class="section-title">Pour aller plus loin</h2>
    </div>
    <div class="reads-grid">
      {related.map((r) => (
        <a class="read-card reveal" href={`/blog/${r.slug}`}>
          <span class="read-kicker">Journal du château</span>
          <span class="read-title">{r.title}</span>
          <span class="read-link">Lire l'article →</span>
        </a>
      ))}
    </div>
  </section>
)}

<section class="final" id="final" style="padding-top:120px">
  <span class="section-eyebrow">{m.final.eyebrow}</span>
  <h2 class="reveal">{m.final.titleLine1}<br /><span class="italic">{m.final.titleLine2Italic}</span></h2>
  <p class="reveal">{m.final.text}</p>

  <form class="lead-form reveal" id="leadForm" novalidate>
    <input type="hidden" name="cible" value={cible} />
    <input type="hidden" name="utm_source" id="utmSource" />
    <input type="hidden" name="utm_campaign" id="utmCampaign" />
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

    <div class="row">
      <input type="text" name="prenom" placeholder="Prénom" required />
      <input type="text" name="nom" placeholder="Nom" required />
    </div>
    <div class="row">
      <input type="email" name="email" placeholder="Email" required />
      <input type="tel" name="telephone" placeholder="Téléphone" />
    </div>
    <textarea name="message" rows="4" placeholder="Votre projet : date envisagée, nombre d'invités, vos envies…"></textarea>

    <button type="submit" class="btn-burgundy" id="submitBtn">{m.final.submitLabel}</button>
    <p class="form-status" id="formStatus" role="status"></p>
  </form>
  <div class="response-line reveal">{m.final.responseLine}</div>
</section>

<script is:inline define:vars={{ thanksPath }}>
  (function () {
    const form = document.getElementById("leadForm");
    const status = document.getElementById("formStatus");
    const btn = document.getElementById("submitBtn");
    const q = new URLSearchParams(location.search);
    document.getElementById("utmSource").value = q.get("utm_source") || "";
    document.getElementById("utmCampaign").value = q.get("utm_campaign") || "";

    async function sha256(str) {
      if (!str || !crypto?.subtle) return "";
      const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str.trim().toLowerCase()));
      return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, "0")).join("");
    }

    let formStarted = false;
    form.addEventListener("focusin", () => {
      if (formStarted) return;
      formStarted = true;
      const cb = (form.querySelector("[name=cible]") || {}).value || "";
      window.huberTrack && window.huberTrack("form_start", { cible: cb });
    }, { passive: true });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      btn.disabled = true;
      status.textContent = "Envoi en cours…";
      const data = Object.fromEntries(new FormData(form).entries());
      data.lang = (document.documentElement.lang || "fr").slice(0, 2);
      const qp = new URLSearchParams(location.search);
      data.utm_medium = qp.get("utm_medium") || "";
      data.utm_term = qp.get("utm_term") || "";
      data.utm_content = qp.get("utm_content") || "";
      data.page = location.pathname + location.search;
      data.referrer = document.referrer || "";
      const cookie = (n) => (document.cookie.match(new RegExp("(?:^|; )" + n + "=([^;]*)")) || [])[1] || "";
      data.gclid = decodeURIComponent(cookie("gclid"));
      data.gbraid = decodeURIComponent(cookie("gbraid"));
      data.wbraid = decodeURIComponent(cookie("wbraid"));
      data.lead_id = crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
      try {
        const res = await fetch("/api/lead", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error("http " + res.status);
        const em = await sha256(data.email);
        const ph = await sha256((data.telephone || "").replace(/[^0-9+]/g, ""));
        const params = new URLSearchParams({ cible: data.cible || "", em, ph, lead_id: data.lead_id });
        if (data.gclid) params.set("gclid", data.gclid);
        location.href = `${thanksPath}?${params.toString()}`;
      } catch (err) {
        btn.disabled = false;
        status.textContent = "Une erreur est survenue. Réessayez ou écrivez-nous à contact@chateaudelahuberdiere.com";
      }
    });
  })();
</script>

<script>
  // Carrousel de photos par chambre : défilement natif scroll-snap + flèches + points.
  // Pas d'autoplay (consigne « ne pas nuire »). Le point actif suit le scroll (swipe compris).
  function initRoomGalleries() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((g) => {
      const track = g.querySelector<HTMLElement>(".room-gallery__track");
      const slides = g.querySelectorAll(".room-gallery__slide");
      const dots = Array.from(g.querySelectorAll<HTMLElement>(".room-gallery__dot"));
      if (!track || slides.length < 2) return;
      const current = () => Math.round(track.scrollLeft / track.clientWidth);
      const setActive = (i: number) =>
        dots.forEach((d, k) => d.setAttribute("aria-current", String(k === i)));
      const go = (i: number) => {
        const n = Math.max(0, Math.min(slides.length - 1, i));
        track.scrollTo({ left: n * track.clientWidth, behavior: reduce ? "auto" : "smooth" });
      };
      g.querySelector(".room-gallery__nav--prev")?.addEventListener("click", () => go(current() - 1));
      g.querySelector(".room-gallery__nav--next")?.addEventListener("click", () => go(current() + 1));
      dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
      let raf = 0;
      track.addEventListener("scroll", () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => setActive(current()));
      });
      setActive(0);
    });
  }
  initRoomGalleries();
  document.addEventListener("astro:page-load", initRoomGalleries);
</script>

<style>
  .stats-band { padding: 56px 24px; background: #fbfaf6; border-bottom: 1px solid #ece6d8; }
  .stats-row {
    max-width: 980px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;
  }
  .stat { text-align: center; }
  .stat .big {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(34px, 4vw, 50px); color: #8b0000; line-height: 1;
  }
  .stat .lbl {
    margin-top: 12px; color: #646464;
    font-family: "Montserrat", sans-serif; font-size: 0.82rem;
    letter-spacing: 0.04em; line-height: 1.5;
  }

  .extras { padding: 110px 24px 20px; }
  .extras-head { text-align: center; max-width: 700px; margin: 0 auto 56px; }
  .extras-grid {
    max-width: 1080px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 32px;
  }
  .extra-card {
    border-top: 2px solid #8b0000; padding: 24px 4px 0;
  }
  .extra-card h3 {
    font-family: "Playfair Display", Georgia, serif;
    color: #2e3a48; font-size: 1.2rem; margin: 0 0 10px;
  }
  .extra-card p { color: #646464; line-height: 1.65; margin: 0; font-size: 0.96rem; }

  /* Activités : liste éditoriale, pas une grille de cards identiques */
  .activities { padding: 100px 24px 20px; }
  .activities-intro {
    margin: 18px auto 0; max-width: 640px; color: #646464;
    font-family: "Montserrat", sans-serif; line-height: 1.7; font-size: 0.96rem;
  }
  .activities-list {
    max-width: 1000px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px 56px;
  }
  .activity-item { padding: 26px 0; border-bottom: 1px solid #ece6d8; }
  .activity-item h3 {
    font-family: "Playfair Display", Georgia, serif;
    color: #2e3a48; font-size: 1.12rem; margin: 0 0 8px;
  }
  .activity-item p { color: #646464; line-height: 1.65; margin: 0; font-size: 0.94rem; }

  /* Chambres : fiches éditoriales (photo + libellés pratiques), consultables sans dates */
  .rooms { padding: 100px 24px 20px; }
  .rooms-list { max-width: 1040px; margin: 0 auto; }
  .room-card {
    display: grid; grid-template-columns: minmax(0, 44%) 1fr; gap: 44px;
    align-items: center; padding: 44px 0; border-top: 1px solid #e6dfce;
  }
  .room-card--reverse .room-card__media { order: 2; }
  .room-card--nomedia { grid-template-columns: 1fr; max-width: 760px; margin: 0 auto; }
  .room-card__media { margin: 0; }
  .room-card__media picture, .room-gallery__slide picture { display: block; width: 100%; }
  .room-card__media img {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;
  }
  /* Carrousel de photos par chambre (défilement natif scroll-snap + flèches + points) */
  .room-gallery { position: relative; }
  .room-gallery__track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; scrollbar-width: none; -ms-overflow-style: none;
  }
  .room-gallery__track::-webkit-scrollbar { display: none; }
  .room-gallery__slide { flex: 0 0 100%; scroll-snap-align: center; margin: 0; }
  .room-gallery__slide img { aspect-ratio: 4 / 5; }
  .room-gallery__nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 40px; height: 40px; border: 0; border-radius: 50%; cursor: pointer;
    background: rgba(244, 242, 236, 0.86); color: #2e3a48; font-size: 22px; line-height: 1;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.25s, color 0.25s; z-index: 2;
  }
  .room-gallery__nav:hover { background: #8b0000; color: #fff; }
  .room-gallery__nav:focus-visible { outline: 2px solid #8b0000; outline-offset: 2px; }
  .room-gallery__nav--prev { left: 12px; }
  .room-gallery__nav--next { right: 12px; }
  .room-gallery__dots {
    position: absolute; bottom: 12px; left: 0; right: 0; z-index: 2;
    display: flex; gap: 7px; justify-content: center;
  }
  .room-gallery__dot {
    width: 7px; height: 7px; border-radius: 50%; border: 0; padding: 0; cursor: pointer;
    background: rgba(244, 242, 236, 0.6); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
    transition: background 0.25s, transform 0.25s;
  }
