---
import { octorateUrl } from "../lib/octorate";

// Barre d'action fixe en bas d'écran, sous 960 px uniquement.
//
// Elle ne répare pas un décrochage mobile : les données ne montrent aucun déficit
// d'engagement (le mobile rebondit à 61,3 % contre 70,0 % en desktop). Elle capte
// une intention mobile déjà démontrée : sur 30 jours, contact_click compte 19
// mobiles pour 2 desktops, et reserve_click 179 pour 108. Le visiteur mobile agit
// plus, mais il doit remonter jusqu'au header ou descendre jusqu'au formulaire
// pour le faire.
//
// Les deux actions sont volontairement dissemblables : appeler d'un côté, ouvrir
// le bon tunnel de l'autre. Un doublon du bouton du header n'apporterait rien.

interface Props {
  ctaKind?: "form" | "book";
  lang?: "fr" | "en" | "it";
  settings: any;
}
const { ctaKind = "book", lang = "fr", settings: s } = Astro.props;

const isQuote = ctaKind === "form";
const href = isQuote ? "#final" : octorateUrl();
const label = isQuote ? (s.quoteLabel ?? s.reserveLabel) : s.reserveLabel;

const callLabel = { fr: "Appeler", en: "Call", it: "Chiamare" }[lang];
const phoneHref = s.footer?.phoneHref;
const barLabel = { fr: "Actions rapides", en: "Quick actions", it: "Azioni rapide" }[lang];
---

<div class="sticky-cta" id="stickyCta" role="group" aria-label={barLabel}>
  {phoneHref && (
    <a class="sticky-cta__call" href={`tel:${phoneHref}`}>{callLabel}</a>
  )}
  <a
    class="sticky-cta__main"
    href={href}
    data-track={isQuote ? "quote_click" : undefined}
    target={isQuote ? undefined : "_blank"}
    rel={isQuote ? undefined : "noopener"}
  >{label}</a>
</div>

<style>
  .sticky-cta {
    display: none;
  }

  @media (max-width: 960px) {
    .sticky-cta {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 9990;
      display: flex;
      align-items: stretch;
      background: var(--bg);
      /* Filet bordeaux, pas une ombre portée : la charte demande des angles vifs
         et un filet de marque plutôt qu'un flottement générique. */
      border-top: 1px solid var(--burgundy);
      font-family: "Montserrat", sans-serif;
      padding-bottom: env(safe-area-inset-bottom, 0);
      /* Masquée tant que le héros est à l'écran : au premier écran, la barre de
         recherche Octorate est déjà l'élément transactionnel, et un cinquième
         appel à l'action par-dessus ne ferait que la recouvrir. */
      transform: translateY(100%);
      transition: transform 0.22s ease;
      will-change: transform;
    }

    .sticky-cta.is-visible {
      transform: translateY(0);
    }

    .sticky-cta a {
      display: flex;
      align-items: center;
      justify-content: center;
      /* 52 px de haut : au-dessus des 44 px de cible tactile recommandés. */
      min-height: 52px;
      padding: 14px 16px;
      font-size: 13px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      font-weight: 400;
    }

    .sticky-cta__call {
      flex: 0 0 34%;
      color: var(--ink);
      background: var(--bg);
      border-right: 1px solid var(--line);
    }

    .sticky-cta__main {
      flex: 1;
      color: #fff;
      background: var(--burgundy);
    }

    .sticky-cta__main:hover,
    .sticky-cta__main:focus-visible {
      background: #6e0808;
      color: #fff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition: none;
    }
  }

  /* Sur les écrans très courts en paysage, la barre mangerait la moitié de la
     vue utile : on la retire plutôt que de la laisser gêner la lecture. */
  @media (max-width: 960px) and (max-height: 420px) {
    .sticky-cta {
      display: none;
    }
  }
</style>

<script>
  // La barre apparaît une fois le héros dépassé, et se retire quand on remonte :
  // le bouton du header redevient alors visible et suffit.
  const bar = document.getElementById("stickyCta");
  if (bar) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const on = window.scrollY > window.innerHeight * 0.85;
      bar.classList.toggle("is-visible", on);
      // Le bandeau cookies et le bouton du header s'accordent sur cet état :
      // remonter l'un, masquer l'autre, plutôt que de laisser trois appels à
      // l'action identiques empilés sur 100 px de haut.
      document.documentElement.classList.toggle("sticky-cta-on", on);
    };
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      },
      { passive: true }
    );
    update();
  }
</script>
