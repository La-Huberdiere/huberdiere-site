# huberdiere-site — variables d'environnement (modèle, sans valeurs)
# Copier en .env et remplir. Ne jamais committer .env (déjà gitignoré).

# Keystatic, mode GitHub (édition en prod). Renseignés par le wizard Keystatic.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Secret de session Keystatic (openssl rand -hex 32).
KEYSTATIC_SECRET=

# Brevo (réception des leads).
BREVO_API_KEY=

# DeepL (traduction FR→EN/IT, plan Free, clé suffixe :fx)
DEEPL_API_KEY=

# Mesure d'audience (préfixe PUBLIC_ = exposé au navigateur). Si vide, rien ne charge.
# GTM : héberge GA4 + Google Ads, passe sous Consent Mode v2 (refusé par défaut).
PUBLIC_GTM_ID=
# Umami (cookieless, RGPD) : URL du script + ID du site, depuis umami.morain.fr.
PUBLIC_UMAMI_SRC=https://umami.morain.fr/script.js
PUBLIC_UMAMI_WEBSITE_ID=
