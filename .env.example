# huberdiere-site — variables d'environnement (modèle, sans valeurs)
# Copier en .env et remplir. Ne jamais committer .env (déjà gitignoré).

# Keystatic, mode GitHub (édition en prod). Renseignés par le wizard Keystatic.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Secret de session Keystatic (openssl rand -hex 32).
KEYSTATIC_SECRET=

# Brevo (réception des leads).
BREVO_API_KEY=

# DeepL (traduction FR→EN/IT, plan Free, clé suffixe :fx)
DEEPL_API_KEY=
