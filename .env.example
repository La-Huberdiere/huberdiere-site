# huberdiere-site — variables d'environnement (modèle, sans valeurs)
# Copier en .env et remplir. Ne jamais committer .env (déjà gitignoré).

# Keystatic, mode GitHub (édition en prod). Renseignés par le wizard Keystatic.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Secret de session Keystatic (openssl rand -hex 32).
KEYSTATIC_SECRET=

# Brevo (réception des leads).
BREVO_API_KEY=

# DeepL (traduction FR→EN/IT, plan Free, clé suffixe :fx)
DEEPL_API_KEY=

# Mesure d'audience (préfixe PUBLIC_ = exposé au navigateur). Si vide, rien ne charge.
# GTM : héberge GA4 + Google Ads, passe sous Consent Mode v2 (refusé par défaut).
PUBLIC_GTM_ID=
# Umami (cookieless, RGPD) : URL du script + ID du site, depuis umami.morain.fr.
PUBLIC_UMAMI_SRC=https://umami.morain.fr/script.js
PUBLIC_UMAMI_WEBSITE_ID=

# Umami API (rapport mensuel : bloc « Fréquentation du site »). Base par défaut
# umami.morain.fr. Auth au choix : soit UMAMI_API_KEY, soit le couple
# UMAMI_USERNAME / UMAMI_PASSWORD (self-hosted classique). UMAMI_WEBSITE_ID est
# optionnel : sans lui, PUBLIC_UMAMI_WEBSITE_ID est réutilisé.
UMAMI_BASE=https://umami.morain.fr
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=
# Lien de partage public Umami proposé au client dans le rapport (défaut codé en dur).
UMAMI_SHARE_URL=https://umami.morain.fr/share/JFnzMWJRC8wXe752

# Hôte servant les images OG (aperçus de partage) avant la bascule DNS. Le domaine
# prod est encore sur Wix : on pointe les images vers l'hôte Vercel réel pour que les
# aperçus marchent. À RETIRER après la bascule du domaine (revient alors au domaine prod).
PUBLIC_OG_HOST=https://huberdiere-site.vercel.app
